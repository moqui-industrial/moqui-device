<entity-facade-xml type="seed">

    <!-- ========== 6-DOF Joint Space + TCP Pose vector-space definitions ========== -->
    <!-- vectorSpaceEnumId references EnumGroup entries in moqui.basic.Enumeration.
        EnumGroupMember links dimension enumerations to the group.
    -->

    <!-- Dimension enumerations for 6 revolute joints -->
    <moqui.basic.EnumerationType description="Joint Dimension" enumTypeId="JointDimension"/>
    <moqui.basic.Enumeration description="Joint 1 (θ₁)" enumId="DimJ1" enumTypeId="JointDimension"/>
    <moqui.basic.Enumeration description="Joint 2 (θ₂)" enumId="DimJ2" enumTypeId="JointDimension"/>
    <moqui.basic.Enumeration description="Joint 3 (θ₃)" enumId="DimJ3" enumTypeId="JointDimension"/>
    <moqui.basic.Enumeration description="Joint 4 (θ₄)" enumId="DimJ4" enumTypeId="JointDimension"/>
    <moqui.basic.Enumeration description="Joint 5 (θ₅)" enumId="DimJ5" enumTypeId="JointDimension"/>
    <moqui.basic.Enumeration description="Joint 6 (θ₆)" enumId="DimJ6" enumTypeId="JointDimension"/>

    <!-- EnumGroup: 6-DOF joint configuration space -->
    <moqui.basic.Enumeration description="6-DOF Joint Configuration Space" enumId="EngJointSpace6Dof" enumTypeId="EnumGroup"/>
    <moqui.basic.EnumGroupMember enumId="DimJ1" enumGroupEnumId="EngJointSpace6Dof" sequenceNum="1"/>
    <moqui.basic.EnumGroupMember enumId="DimJ2" enumGroupEnumId="EngJointSpace6Dof" sequenceNum="2"/>
    <moqui.basic.EnumGroupMember enumId="DimJ3" enumGroupEnumId="EngJointSpace6Dof" sequenceNum="3"/>
    <moqui.basic.EnumGroupMember enumId="DimJ4" enumGroupEnumId="EngJointSpace6Dof" sequenceNum="4"/>
    <moqui.basic.EnumGroupMember enumId="DimJ5" enumGroupEnumId="EngJointSpace6Dof" sequenceNum="5"/>
    <moqui.basic.EnumGroupMember enumId="DimJ6" enumGroupEnumId="EngJointSpace6Dof" sequenceNum="6"/>

    <!-- Dimension enumerations for 6-DOF TCP poses expressed as X,Y,Z,A,B,C -->
    <moqui.basic.EnumerationType description="TCP Pose Dimension" enumTypeId="TcpPoseDimension"/>
    <moqui.basic.Enumeration description="TCP X Position" enumId="DimTcpX" enumCode="X" enumTypeId="TcpPoseDimension"/>
    <moqui.basic.Enumeration description="TCP Y Position" enumId="DimTcpY" enumCode="Y" enumTypeId="TcpPoseDimension"/>
    <moqui.basic.Enumeration description="TCP Z Position" enumId="DimTcpZ" enumCode="Z" enumTypeId="TcpPoseDimension"/>
    <moqui.basic.Enumeration description="TCP A Orientation" enumId="DimTcpA" enumCode="A" enumTypeId="TcpPoseDimension"/>
    <moqui.basic.Enumeration description="TCP B Orientation" enumId="DimTcpB" enumCode="B" enumTypeId="TcpPoseDimension"/>
    <moqui.basic.Enumeration description="TCP C Orientation" enumId="DimTcpC" enumCode="C" enumTypeId="TcpPoseDimension"/>

    <!-- EnumGroup: 6-DOF TCP pose space aligned with PLCopen motion FBs -->
    <moqui.basic.Enumeration description="6-DOF TCP Pose Space" enumId="EngTcpPose6Dof" enumTypeId="EnumGroup"/>
    <moqui.basic.EnumGroupMember enumId="DimTcpX" enumGroupEnumId="EngTcpPose6Dof" sequenceNum="1"/>
    <moqui.basic.EnumGroupMember enumId="DimTcpY" enumGroupEnumId="EngTcpPose6Dof" sequenceNum="2"/>
    <moqui.basic.EnumGroupMember enumId="DimTcpZ" enumGroupEnumId="EngTcpPose6Dof" sequenceNum="3"/>
    <moqui.basic.EnumGroupMember enumId="DimTcpA" enumGroupEnumId="EngTcpPose6Dof" sequenceNum="4"/>
    <moqui.basic.EnumGroupMember enumId="DimTcpB" enumGroupEnumId="EngTcpPose6Dof" sequenceNum="5"/>
    <moqui.basic.EnumGroupMember enumId="DimTcpC" enumGroupEnumId="EngTcpPose6Dof" sequenceNum="6"/>

    <!-- ========== Robot controller + DeviceRequest for export#Trajectory ========== -->
    <!--
        Minimal records needed to test moqui.device.TrajectoryPlannerServices.export#Trajectory.
        The request is an MQTT write without items, run by moqui-device-gateway: replace brokerUri with the
        actual broker in production. The MQTT topic in DeviceRequest.query must match the MqttParameterSub
        subscription on the PLC side (JsonToParametersMapper expected keys: "X","Y","Z","A","B","C"
        for TCP pose trajectories, or "J1"…"J6" for joint-space trajectories).
    -->
    <moqui.device.Device deviceId="ROBOT_ARM_01"
        deviceTypeEnumId="DtRobotController"/>
    <moqui.device.PhysicalDevice deviceId="ROBOT_ARM_01"
        deviceName="Robot Arm 1"
        modelName="6-DOF Robot Arm Controller"/>

    <moqui.device.DeviceRequest requestName="ROBOT_ARM_TRAJECTORY_EXPORT"
        deviceId="ROBOT_ARM_01"
        routerEnumId="DrrMQTTBroker"
        requestTypeEnumId="DrtWrite"
        runServiceName="moqui.device.gateway.MqttServices.run#DeviceRequest"
        brokerUri="mqtt://localhost:1883"
        query="moqui/robot/arm1/trajectory"
        timeout="30000"
        description="Publishes 6-DOF robot arm trajectory waypoints over MQTT (ephemeral bulk path)."/>

    <!-- ========== MathModelDef: 6-DOF TCP waypoint planner ========== -->
    <!-- 
        Model type  : MmtDlFeedforward (Feedforward Neural Network, sub-type of MmtDlModel)
        Usage : MmucInference
        Domain : MmdEngineering
        Service : moqui.device.TrajectoryPlannerServices.run#RobotArmTrajectoryPlanner
    -->
    <moqui.math.MathModelDef mathModelDefId="TrjPlannerMlp6Dof"
        modelTypeEnumId="MmtDlFeedforward" usageContextEnumId="MmucInference"
        domainEnumId="MmdEngineering" serviceName="moqui.device.TrajectoryPlannerServices.run#RobotArmTrajectoryPlanner"
        modelName="6-DOF TCP Waypoint Planner"
        description="AI waypoint planner whose service contract is now TCP-pose based.
            Input: [tcp_start(6) ‖ tcp_goal(6)] with TCP components [X,Y,Z,A,B,C].
            Output: N_WAYPOINTS × 6 TCP poses (flat). Retrain or replace the bundled
            ONNX model accordingly before production use."
        versionNumber="1" releaseStatusId="MathModelProduction"/>

    <!-- ========== MathModelDefIdentification: internal registry ========== -->
    <!-- 
        externalSystemEnumId: MmesInternal (Internal Registry)
        externalId: moqui-device/trajectory-planner-mlp-6dof
    -->
    <moqui.math.MathModelDefIdentification mathModelDefId="TrjPlannerMlp6Dof"
        externalSystemEnumId="MmesInternal" fromDate="2026-06-22 00:00:00"
        externalId="moqui-device/trajectory-planner-mlp-6dof" externalVersion="1.0"
        isPrimary="Y" description="Internal identifier for the bundled 6-DOF TCP waypoint planner model."/>

    <!-- ========== MathModelDefContent: ONNX file ========== -->
    <!-- 
        The ONNX file component://moqui-device/data/ml/trajectory_planner.onnx is committed; regenerate it with
        script/train_robot_arm_trajectory_planner.py (PyTorch, onnx, onnxscript).
    -->
    <moqui.math.MathModelDefContent mathModelDefContentId="TrjPlannerMlp6DofOnnx"
        mathModelDefId="TrjPlannerMlp6Dof" contentLocation="component://moqui-device/data/ml/trajectory_planner.onnx"
        contentTypeEnumId="MmCntOnnx" purposeEnumId="MmCnpMainLogic" contentDate="2026-06-22 00:00:00"
        description="ONNX export of the 6-DOF TCP waypoint planner.
            Generate with: python script/train_robot_arm_trajectory_planner.py"/>

    <!-- ========== MathModel: production instance ========== -->
    <!-- sourceEnumId: MmsSimulated (trained on synthetic quintic-spline data) -->
    <moqui.math.MathModel mathModelId="TrjPlannerMlp6DofV1" mathModelDefId="TrjPlannerMlp6Dof"
        sourceEnumId="MmsSimulated" modelAlias="trj-planner-v1"
        description="Production instance of the 6-DOF TCP waypoint planner v1."
        statusId="MathModelProduction" statusFlowId="MathModelStatusFlow"/>
</entity-facade-xml>

<?xml version="1.0" encoding="UTF-8"?>
<moqui-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/moqui-conf-3.xsd">
    <default-property name="onnx.session.cache.max" value="8"/>
    <!-- The DeviceGroupMember (DgmpEdgeGateway) Device this instance is. Set: subscriptions of the controllers in its
         scope are restored after a start and requests outside its scope are refused; empty: no restoration, no scope. -->
    <default-property name="device_gateway_device_id" value=""/>
    <!-- false: this instance does not start the subscriptions (only one instance should own them) -->
    <default-property name="device_gateway_restore_subscriptions" value="true"/>
    <!-- Where DeviceServices.export#DeviceConfig writes a recipe when its DeviceRequest has no DeviceConnection:
         file:directory or sftp://host:port/directory -->
    <default-property name="device_config_export_location" value=""/>
    <default-property name="device_config_export_location_2" value=""/>
    <tools>
        <tool-factory class="moqui_device::TrajectoryGeneratorFactory" init-priority="25"/>
        <tool-factory class="moqui_device::DeviceSubscriptionsFactory" init-priority="25"/>
    </tools>
</moqui-conf>

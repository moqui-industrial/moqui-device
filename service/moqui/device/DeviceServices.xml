<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ========== Device Services ========== -->

    <service verb="send" noun="DeviceNotification" authenticate="false">
        <description>
            Tells the users about an event of a Device on a topic of DeviceData.xml (DeviceGatewayRequest,
            DeviceGatewayRequestCompleted, DeviceGatewayRequestFailed, DeviceGatewayInboundFailed,
            DeviceGatewayInboundRecovered): deviceId, deviceName, requestName, eventType, title and text, the Device as
            the record. The recipients are the members of the user groups with the permission DEVICE_NOTIFY, besides
            the sender, the userIds given and the topic's subscribers. The topic gives the type, the alert, the inbox
            and the title. A notice that fails is logged; the caller's work stands.
        </description>
        <in-parameters>
            <parameter name="deviceId" required="true"/>
            <parameter name="topic" required="true"/>
            <parameter name="title" required="true"/>
            <parameter name="text"/>
            <parameter name="requestName"/>
            <parameter name="eventType"/>
            <parameter name="userIds" type="List"><description>Recipients besides the holders of DEVICE_NOTIFY.</description></parameter>
        </in-parameters>
        <actions>
            <set field="devices" from="ec.resource.script('component://moqui-device/service/moqui/device/Devices.js')"/>
            <set field="answer" from="devices.execute('notify', context)"/>
        </actions>
    </service>

    <service verb="receive" noun="GatewayRequestCallback" authenticate="false" transaction="ignore">
        <description>
            Receives the success or failure of a device request execution and translates it into a user-facing
            notification (send#DeviceNotification): writeCompleted and exportCompleted on DeviceGatewayRequestCompleted,
            writeFailed or a failed status on DeviceGatewayRequestFailed, any other event on DeviceGatewayRequest.
        </description>
        <in-parameters>
            <parameter name="eventType" required="true"/>
            <parameter name="requestName" required="true"/>
            <parameter name="deviceId"/>
            <parameter name="status"/>
            <parameter name="protocol"/>
            <parameter name="routeId"/>
            <parameter name="rowCount" type="Integer"/>
            <parameter name="message"/>
            <parameter name="publishUriList" type="List"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="moqui.device.DeviceRequest" value-field="request">
                <field-map field-name="requestName"/>
            </entity-find-one>
            <if condition="request == null">
                <return error="true" message="DeviceRequest not found for requestName ${requestName}."/>
            </if>

            <entity-find-one entity-name="moqui.device.DeviceDetail" value-field="device">
                <field-map field-name="deviceId" from="deviceId || request.deviceId"/>
            </entity-find-one>
            <if condition="device == null">
                <return error="true" message="Device not found for request ${requestName}."/>
            </if>

            <set field="deviceLabel" from="device.deviceName || device.deviceId"/>
            <set field="notificationTopic" value="DeviceGatewayRequest"/>
            <set field="notificationTitle" from="'Gateway callback for ' + deviceLabel"/>
            <set field="notificationMessage" from="message || ('Gateway event ' + eventType + ' completed for request ' + requestName + '.')"/>

            <if condition="eventType === 'writeCompleted'">
                <set field="notificationTopic" value="DeviceGatewayRequestCompleted"/>
                <set field="notificationTitle" from="'Sync Parameters completed for ' + deviceLabel"/>
                <set field="notificationMessage"
                        from="message || ('Synchronized ' + (rowCount || 0) + ' parameter value(s) to device ' + deviceLabel + (protocol ? ' via ' + protocol : '') + '.')"/>
            </if>
            <if condition="eventType === 'exportCompleted'">
                <set field="notificationTopic" value="DeviceGatewayRequestCompleted"/>
                <set field="notificationTitle" from="'Download Process completed for ' + deviceLabel"/>
                <set field="notificationMessage"
                        from="message || ('Device configuration export completed for device ' + deviceLabel + '.')"/>
            </if>
            <if condition="eventType === 'writeFailed' || ['error', 'failed'].includes(status)">
                <set field="notificationTopic" value="DeviceGatewayRequestFailed"/>
                <set field="notificationTitle" from="'Gateway request failed for ' + deviceLabel"/>
                <set field="notificationMessage"
                        from="message || ('Gateway request ' + requestName + ' failed for device ' + deviceLabel + (protocol ? ' via ' + protocol : '') + '.')"/>
            </if>

            <service-call name="moqui.device.DeviceServices.send#DeviceNotification"
                    in-map="{deviceId:device.deviceId, topic:notificationTopic, title:notificationTitle,
                            text:notificationMessage, requestName:requestName, eventType:eventType}"/>
            <log level="info" message="Processed gateway request callback ${eventType} for request ${requestName}, device ${device.deviceId}."/>
        </actions>
    </service>

    <service verb="apply" noun="DeviceConfig">
        <description>
            Apply a DeviceConfig to a Device.

            This service materializes the declared configuration values of a DeviceConfig onto an existing Device.
            It copies compatible DeviceConfig-level fields to the target Device and updates only existing
            device-bound Parameter rows that match source configuration parameters by parameterDefId and
            parameterAlias.

            The service does not create ParameterDef rows, does not create missing Parameter(deviceId) rows,
            and does not write to the real physical device. It updates only Moqui-side Device and Parameter state.
        </description>
        <in-parameters>
            <parameter name="deviceConfigId" required="true"/>
            <parameter name="deviceId" required="true"/>
            <parameter name="validateDeviceType" type="Boolean" default="true"/>
            <parameter name="copyDeviceFields" type="Boolean" default="true"/>
            <parameter name="copySequenceNum" type="Boolean" default="false"/>
            <parameter name="dryRun" type="Boolean" default="false"/>
        </in-parameters>
        <out-parameters>
            <parameter name="sourceParameterCount" type="Integer"/>
            <parameter name="targetParameterCount" type="Integer"/>
            <parameter name="commonParameterCount" type="Integer"/>
            <parameter name="updatedParameterCount" type="Integer"/>
            <parameter name="skippedParameterKeySet" type="Set"/>
            <parameter name="updatedParameterIdList" type="List"/>
            <parameter name="updatedDeviceFieldList" type="List"/>
        </out-parameters>
        <actions>
            <set field="devices" from="ec.resource.script('component://moqui-device/service/moqui/device/Devices.js')"/>
            <set field="answer" from="devices.execute('applyConfig', context)"/>
            <set field="sourceParameterCount" from="answer.sourceParameterCount"/>
            <set field="targetParameterCount" from="answer.targetParameterCount"/>
            <set field="commonParameterCount" from="answer.commonParameterCount"/>
            <set field="updatedParameterCount" from="answer.updatedParameterCount"/>
            <set field="skippedParameterKeySet" from="answer.skippedParameterKeySet"/>
            <set field="updatedParameterIdList" from="answer.updatedParameterIdList"/>
            <set field="updatedDeviceFieldList" from="answer.updatedDeviceFieldList"/>
        </actions>
    </service>

    <!-- ========== Device Request Services ========== -->

    <service verb="run" noun="DeviceRequestGroup" authenticate="false" transaction="ignore">
        <description>Run a device request group. Mainly used to mark transactions.
            This is meant to be called as a scheduled service.</description>
        <in-parameters>
            <parameter name="requestGroup" required="true"/>
            <parameter name="async" type="Boolean" default="true"/>
        </in-parameters>
        <actions>
            <entity-find entity-name="moqui.device.DeviceRequest" list="requestList" cache="true">
                <econdition field-name="requestGroup"/>
                <order-by field-name="priority"/>
            </entity-find>
            <iterate list="requestList" entry="request">
                <log level="info" message="Run device request with name ${request.requestName} in the group ${request.requestGroup}."/>
                <if condition="async"><then>
                    <service-call name="moqui.device.DeviceServices.run#DeviceRequest" in-map="{requestName:request.requestName}"
                        async="true" ignore-error="true" transaction="ignore"/>
                </then><else>
                    <service-call name="moqui.device.DeviceServices.run#DeviceRequest" in-map="{requestName:request.requestName}"
                        ignore-error="true" transaction="ignore"/>
                </else></if>
            </iterate>
        </actions>
    </service>
    <service verb="run" noun="DeviceRequest" authenticate="false" transaction="ignore">
        <description>Run a device request: with its runServiceName, else on the driver of its connection
            (FieldbusServices.run#FieldbusRequest).</description>
        <in-parameters>
            <parameter name="requestName" required="true"/>
            <parameter name="payload" type="Map"><description>The message of an MQTT write without items.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="status"/>
            <parameter name="samples" type="List"/>
            <parameter name="storedCount" type="Long"/>
            <parameter name="itemResults" type="List"/>
            <parameter name="subscriptionId"/>
            <parameter name="errorMessage"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="moqui.device.DeviceRequest" value-field="request" cache="true"/>
            <if condition="!request">
                <return error="true" message="Device request not found. Could not run the device request with name ${requestName}."/>
            </if>
            <set field="runServiceName" from="request.runServiceName || 'moqui.device.FieldbusServices.run#FieldbusRequest'"/>

            <entity-find-one entity-name="moqui.device.Device" value-field="device" cache="true">
                <field-map field-name="deviceId" from="request.deviceId"/>
            </entity-find-one>

            <if condition="request.connectionName">
                <entity-find-one entity-name="moqui.device.DeviceConnection" value-field="connection" cache="true">
                    <field-map field-name="connectionName" from="request.connectionName"/>
                </entity-find-one>
                <if condition="!connection">
                    <return error="true" message="The device request does not have a connection set. Could not run the device request with name ${requestName}."/>
                </if>
            </if>

            <entity-find entity-name="moqui.device.DeviceRequestItem" list="bulkRequestItemList" cache="true">
                <econdition field-name="requestName" from="requestName"/>
                <econdition field-name="query" operator="is-null"/>
                <order-by field-name="sequenceNum"/>
            </entity-find>

            <entity-find entity-name="moqui.device.DeviceRequestItem" list="requestItemList" cache="true">
                <econdition field-name="requestName" from="requestName"/>
                <econdition field-name="query" operator="is-not-null"/>
                <order-by field-name="sequenceNum"/>
            </entity-find>

            <!-- Filter write requests to send only changed parameters.
                 This filtering only makes sense for items not in a bulk request. -->
            <if condition="'DrtWrite' === request.requestTypeEnumId &amp;&amp; 'Y' === request.onlyChangedParameters">
                <set field="parameterIdSet" from="requestItemList.map(it => it.parameterId)"/>
                <entity-find entity-name="moqui.entity.EntityAuditLog" list="changedRows" distinct="true" cache="false">
                    <econdition field-name="changedEntityName" value="moqui.math.Parameter"/>
                    <econdition field-name="pkPrimaryValue" operator="in" from="parameterIdSet"/>
                    <econdition field-name="changedDate" operator="greater" from="request.lastUpdatedStamp"/>
                    <order-by field-name="pkPrimaryValue"/>
                    <select-field field-name="pkPrimaryValue"/>
                </entity-find>
                <set field="changedIds" from="changedRows.map(it => it.pkPrimaryValue)"/>
                <set field="requestItemList" from="requestItemList.filter(it => changedIds.includes(it.parameterId))"/>
                <if condition="parameterIdSet.length &amp;&amp; !requestItemList.length &amp;&amp; !bulkRequestItemList.length">
                    <return message="The device request with name ${requestName} has no changed parameters to write."/>
                </if>
            </if>
            <if condition="!bulkRequestItemList.length &amp;&amp; !requestItemList.length &amp;&amp; !request.query
                    &amp;&amp; request.requestTypeEnumId !== 'DrtUnsubscribe'">
                <return message="The device request with name ${requestName} has no items to process."/>
            </if>
            <log level="info" message="Running device request with name ${request.requestName}."/>
            <!-- Call the configured service, or the driver of the connection. -->
            <service-call name="${runServiceName}" in-map="{device:device, request:request,
                connection:connection,
                bulkRequestItemList:bulkRequestItemList, requestItemList:requestItemList, payload:payload}"
                out-map="context" disable-authz="true" transaction="ignore"/>
        </actions>
    </service>
    <!-- The interface that tools or libraries will need to implement for fieldbus communications. -->
    <service verb="run" noun="DeviceRequestInternal" type="interface">
        <description>Run a device request over a fieldbus protocol.</description>
        <in-parameters>
            <parameter name="device" required="true" type="EntityValue"/>
            <parameter name="request" required="true" type="EntityValue"/>
            <parameter name="connection" type="EntityValue"/>
            <parameter name="requestItemList" type="List"/>
            <parameter name="bulkRequestItemList" type="List"/>
        </in-parameters>
    </service>

    <!-- ========== DeviceContent Services ========== -->

    <service verb="get" noun="DeviceContentLocation">
        <in-parameters>
            <parameter name="deviceId" required="true"/>
            <parameter name="contentTypeEnumIdList" type="List" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="contentLocation"/>
            <parameter name="deviceContent"/>
        </out-parameters>
        <actions>
            <iterate list="contentTypeEnumIdList" entry="contentTypeEnumId">
                <entity-find entity-name="moqui.device.DeviceContent" list="deviceContentList">
                    <econdition field-name="deviceId"/><econdition field-name="contentTypeEnumId"/>
                    <order-by field-name="-contentDate"/></entity-find>
                <if condition="(deviceContentList?.length > 0)">
                    <set field="deviceContent" from="deviceContentList[0]"/>
                    <break/>
                </if>
            </iterate>
            <set field="contentLocation" from="deviceContent ? deviceContent.contentLocation : null"/>
        </actions>
    </service>

    <service verb="create" noun="DeviceContent">
        <in-parameters>
            <auto-parameters entity-name="moqui.device.DeviceContent" include="nonpk">
                <exclude field-name="contentLocation"/></auto-parameters>
            <parameter name="deviceId" required="true"/>
            <parameter name="contentFile" type="org.apache.commons.fileupload2.core.FileItem"/>
        </in-parameters>
        <out-parameters><parameter name="deviceContentId"/></out-parameters>
        <actions>
            <service-call name="create#moqui.device.DeviceContent" in-map="context" out-map="context"/>
            <if condition="contentFile != null &amp;&amp; contentFile.size &gt; 0">
                <service-call name="moqui.device.DeviceServices.save#DeviceContentFile" in-map="context"/></if>
        </actions>
    </service>
    <service verb="update" noun="DeviceContent">
        <in-parameters>
            <parameter name="deviceContentId" required="true"/>
            <auto-parameters entity-name="moqui.device.DeviceContent" include="nonpk">
                <exclude field-name="contentLocation"/></auto-parameters>
            <parameter name="contentFile" type="org.apache.commons.fileupload2.core.FileItem"/>
        </in-parameters>
        <actions>
            <if condition="contentFile != null &amp;&amp; contentFile.size &gt; 0">
                <entity-find-one entity-name="moqui.device.DeviceContent" value-field="deviceContent"/>
                <service-call name="moqui.device.DeviceServices.save#DeviceContentFile" out-map="context"
                        in-map="Object.assign({}, context, {deviceId:deviceContent.deviceId, saveContentLocation:false})"/>
            </if>
            <service-call name="update#moqui.device.DeviceContent" in-map="context"/>
        </actions>
    </service>
    <service verb="save" noun="DeviceContentFile">
        <in-parameters>
            <parameter name="deviceContentId" required="true"/>
            <parameter name="deviceId" required="true"/>
            <parameter name="contentFile" type="org.apache.commons.fileupload2.core.FileItem" required="true"/>
            <parameter name="saveContentLocation" type="Boolean" default="true"/>
        </in-parameters>
        <out-parameters><parameter name="contentLocation"/></out-parameters>
        <actions>
            <set field="filename" from="contentFile.getName()"/>
            <if condition="!filename || ['.', '..'].includes(filename) || Array.from(filename).some(c => c === '/' || c === ':' || c.charCodeAt(0) === 92 || c.charCodeAt(0) &lt; 32 || c.charCodeAt(0) === 127)">
                <return error="true" message="A content upload requires a filename, not a path."/>
            </if>
            <entity-find-one entity-name="moqui.device.DeviceContent" value-field="contentOwner"/>
            <if condition="!contentOwner || contentOwner.deviceId !== deviceId">
                <return error="true" message="DeviceContent does not belong to the supplied device."/>
            </if>
            <if condition="ResourceReference.isTextFilename(filename)"><then>
                <set field="contentRoot" from="ec.user.getPreference('mantle.content.root') || 'dbresource://mantle/content'"/>
            </then><else>
                <set field="contentRoot" from="ec.user.getPreference('mantle.content.large.root') || 'dbresource://mantle/content'"/>
            </else></if>
            <set field="contentLocation" value="${contentRoot}/device/${deviceId}/content_${deviceContentId}/${filename}"/>

            <set field="docRr" from="ec.resource.getLocationReference(contentLocation)"/>
            <script>
                const fileStream = contentFile.getInputStream()
                try { docRr.putStream(fileStream) } finally { fileStream.close() }
            </script>

            <if condition="saveContentLocation"><service-call name="update#moqui.device.DeviceContent"
                    in-map="{deviceContentId:deviceContentId, contentLocation:contentLocation}"/></if>
        </actions>
    </service>

</services>

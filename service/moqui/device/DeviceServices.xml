<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ========== Device Services ========== -->

    <service verb="send" noun="DeviceNotification" authenticate="false">
        <description>
            Tells the users about an event of a Device that no caller sees, such as the values of a subscription that
            are not stored (DeviceAcquisitionServices.notify#InboundState and notify#AcquisitionError), on a topic of
            DeviceData.xml (DeviceInboundFailed, DeviceInboundRecovered): deviceId, deviceName, requestName, eventType,
            title and text, the Device as the record. A service called from a screen or a job returns its errors
            instead. The recipients are the members of the user groups with the permission DEVICE_NOTIFY, besides
            the sender, the userIds given and the topic's subscribers. The topic gives the type, the alert, the inbox
            and the title. A notice that fails is logged; the caller's work stands.
        </description>
        <in-parameters>
            <parameter name="deviceId" required="true"/>
            <parameter name="topic" required="true"/>
            <parameter name="title" required="true"/>
            <parameter name="text"/>
            <parameter name="requestName"/>
            <parameter name="eventType"/>
            <parameter name="userIds" type="List"><description>Recipients besides the holders of DEVICE_NOTIFY.</description></parameter>
        </in-parameters>
        <actions>
            <set field="devices" from="ec.resource.script('component://moqui-device/service/moqui/device/Devices.js')"/>
            <set field="answer" from="devices.execute('notify', context)"/>
        </actions>
    </service>

    <service verb="apply" noun="DeviceConfig">
        <description>
            Apply a DeviceConfig to a Device.

            This service materializes the declared configuration values of a DeviceConfig onto an existing Device.
            It copies compatible DeviceConfig-level fields to the target Device and updates only existing
            device-bound Parameter rows that match source configuration parameters by parameterDefId and
            parameterAlias.

            The service does not create ParameterDef rows, does not create missing Parameter(deviceId) rows,
            and does not write to the real physical device. It updates only Moqui-side Device and Parameter state.
        </description>
        <in-parameters>
            <parameter name="deviceConfigId" required="true"/>
            <parameter name="deviceId" required="true"/>
            <parameter name="validateDeviceType" type="Boolean" default="true"/>
            <parameter name="copyDeviceFields" type="Boolean" default="true"/>
            <parameter name="copySequenceNum" type="Boolean" default="false"/>
            <parameter name="dryRun" type="Boolean" default="false"/>
        </in-parameters>
        <out-parameters>
            <parameter name="sourceParameterCount" type="Integer"/>
            <parameter name="targetParameterCount" type="Integer"/>
            <parameter name="commonParameterCount" type="Integer"/>
            <parameter name="updatedParameterCount" type="Integer"/>
            <parameter name="skippedParameterKeySet" type="Set"/>
            <parameter name="updatedParameterIdList" type="List"/>
            <parameter name="updatedDeviceFieldList" type="List"/>
        </out-parameters>
        <actions>
            <set field="devices" from="ec.resource.script('component://moqui-device/service/moqui/device/Devices.js')"/>
            <set field="answer" from="devices.execute('applyConfig', context)"/>
            <set field="sourceParameterCount" from="answer.sourceParameterCount"/>
            <set field="targetParameterCount" from="answer.targetParameterCount"/>
            <set field="commonParameterCount" from="answer.commonParameterCount"/>
            <set field="updatedParameterCount" from="answer.updatedParameterCount"/>
            <set field="skippedParameterKeySet" from="answer.skippedParameterKeySet"/>
            <set field="updatedParameterIdList" from="answer.updatedParameterIdList"/>
            <set field="updatedDeviceFieldList" from="answer.updatedDeviceFieldList"/>
        </actions>
    </service>

    <!-- ========== Device Request Services ========== -->

    <service verb="run" noun="DeviceRequestGroup" authenticate="false" transaction="ignore">
        <description>Run a device request group. Mainly used to mark transactions.
            This is meant to be called as a scheduled service.</description>
        <in-parameters>
            <parameter name="requestGroup" required="true"/>
            <parameter name="async" type="Boolean" default="true"/>
        </in-parameters>
        <actions>
            <entity-find entity-name="moqui.device.DeviceRequest" list="requestList" cache="true">
                <econdition field-name="requestGroup"/>
                <order-by field-name="priority"/>
            </entity-find>
            <iterate list="requestList" entry="request">
                <log level="info" message="Run device request with name ${request.requestName} in the group ${request.requestGroup}."/>
                <if condition="async"><then>
                    <service-call name="moqui.device.DeviceServices.run#DeviceRequest" in-map="{requestName:request.requestName}"
                        async="true" ignore-error="true" transaction="ignore"/>
                </then><else>
                    <service-call name="moqui.device.DeviceServices.run#DeviceRequest" in-map="{requestName:request.requestName}"
                        ignore-error="true" transaction="ignore"/>
                </else></if>
            </iterate>
        </actions>
    </service>
    <service verb="run" noun="DeviceRequest" authenticate="false" transaction="ignore">
        <description>Run a device request with the service in its runServiceName, an implementation of
            run#DeviceRequestInternal (for example moqui-device-gateway's run#DeviceGatewayRequest).</description>
        <in-parameters>
            <parameter name="requestName" required="true"/>
            <parameter name="payload" type="Map"><description>The message of an MQTT write without items.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="status"/>
            <parameter name="samples" type="List"/>
            <parameter name="storedCount" type="Long"/>
            <parameter name="itemResults" type="List"/>
            <parameter name="subscriptionId"/>
            <parameter name="errorMessage"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="moqui.device.DeviceRequest" value-field="request" cache="true"/>
            <if condition="!request">
                <return error="true" message="Device request not found. Could not run the device request with name ${requestName}."/>
            </if>
            <if condition="!request.runServiceName">
                <return error="true" message="The device request does not have a service set. Could not run the device request with name ${requestName}."/>
            </if>

            <entity-find-one entity-name="moqui.device.Device" value-field="device" cache="true">
                <field-map field-name="deviceId" from="request.deviceId"/>
            </entity-find-one>

            <if condition="request.connectionName">
                <entity-find-one entity-name="moqui.device.DeviceConnection" value-field="connection" cache="true">
                    <field-map field-name="connectionName" from="request.connectionName"/>
                </entity-find-one>
                <if condition="!connection">
                    <return error="true" message="The device request does not have a connection set. Could not run the device request with name ${requestName}."/>
                </if>
            </if>

            <entity-find entity-name="moqui.device.DeviceRequestItem" list="bulkRequestItemList" cache="true">
                <econdition field-name="requestName" from="requestName"/>
                <econdition field-name="query" operator="is-null"/>
                <order-by field-name="sequenceNum"/>
            </entity-find>

            <entity-find entity-name="moqui.device.DeviceRequestItem" list="requestItemList" cache="true">
                <econdition field-name="requestName" from="requestName"/>
                <econdition field-name="query" operator="is-not-null"/>
                <order-by field-name="sequenceNum"/>
            </entity-find>

            <!-- Filter write requests to send only changed parameters.
                 This filtering only makes sense for items not in a bulk request. -->
            <if condition="'DrtWrite' === request.requestTypeEnumId &amp;&amp; 'Y' === request.onlyChangedParameters">
                <set field="parameterIdSet" from="requestItemList.map(it => it.parameterId)"/>
                <entity-find entity-name="moqui.entity.EntityAuditLog" list="changedRows" distinct="true" cache="false">
                    <econdition field-name="changedEntityName" value="moqui.math.Parameter"/>
                    <econdition field-name="pkPrimaryValue" operator="in" from="parameterIdSet"/>
                    <econdition field-name="changedDate" operator="greater" from="request.lastUpdatedStamp"/>
                    <order-by field-name="pkPrimaryValue"/>
                    <select-field field-name="pkPrimaryValue"/>
                </entity-find>
                <set field="changedIds" from="changedRows.map(it => it.pkPrimaryValue)"/>
                <set field="requestItemList" from="requestItemList.filter(it => changedIds.includes(it.parameterId))"/>
                <if condition="parameterIdSet.length &amp;&amp; !requestItemList.length &amp;&amp; !bulkRequestItemList.length">
                    <return message="The device request with name ${requestName} has no changed parameters to write."/>
                </if>
            </if>
            <if condition="!bulkRequestItemList.length &amp;&amp; !requestItemList.length &amp;&amp; !request.query
                    &amp;&amp; request.requestTypeEnumId !== 'DrtUnsubscribe'">
                <return message="The device request with name ${requestName} has no items to process."/>
            </if>
            <log level="info" message="Running device request with name ${request.requestName}."/>
            <!-- Call the configured service. -->
            <service-call name="${request.runServiceName}" in-map="{device:device, request:request,
                connection:connection,
                bulkRequestItemList:bulkRequestItemList, requestItemList:requestItemList, payload:payload}"
                out-map="context" disable-authz="true" transaction="ignore"/>
            <!-- An explicit unsubscribe stops the restart of the subscription; a started one resumes it. -->
            <if condition="['DrtSubscribe', 'DrtEvent', 'DrtStateChange', 'DrtCyclic', 'DrtUnsubscribe'].includes(request.requestTypeEnumId)">
                <service-call name="moqui.device.DeviceAcquisitionServices.record#SubscriptionState"
                        in-map="{requestName:requestName, requestTypeEnumId:request.requestTypeEnumId,
                            parentRequestName:request.parentRequestName, status:status}"/>
            </if>
        </actions>
    </service>
    <!-- The interface that tools or libraries will need to implement for fieldbus communications. -->
    <service verb="run" noun="DeviceRequestInternal" type="interface">
        <description>Run a device request over a fieldbus protocol.</description>
        <in-parameters>
            <parameter name="device" required="true" type="EntityValue"/>
            <parameter name="request" required="true" type="EntityValue"/>
            <parameter name="connection" type="EntityValue"/>
            <parameter name="requestItemList" type="List"/>
            <parameter name="bulkRequestItemList" type="List"/>
        </in-parameters>
    </service>

    <!-- ========== Recipe Export and Device Content Transfer ========== -->
    <!-- Only mr-moqui moves files: a recipe extracted from DeviceRuleSet/DeviceRule/DeviceConfig/Parameter, or a CNC
         program, G-Code or firmware of a DeviceContent, is written to the device through the resource facade (file:)
         or the framework's SftpClient (sftp://), with transferFiles of Devices.js. No driver is involved. -->

    <service verb="get" noun="DeviceConfigExportFiles">
        <description>
            Renders the recipe of a DeviceRuleSet as text files, one per DeviceRule priority, named
            ruleSetName_pNN.txt. Each line is name:=value, sorted by name.

            Parameter lines: the Parameter records of the DeviceConfig of each DeviceRule. The name is the
            requestItemName of a DeviceRequestItem of the Parameter when there is one; otherwise it depends on
            DeviceConfig.deviceTypeEnumId: DtPLC gives dev.alias, DtMoquiPlc* gives dev.deviceName.alias, any other
            type gives the alias, or deviceName.parameterName. The alias is Parameter.parameterAlias, or
            ParameterDef.parameterName; deviceName is PhysicalDevice.deviceName, or the deviceId of the rule. The value
            is numericValue, else parameterEnumId, else symbolicValue.

            Trajectory lines, when the DeviceConfig has an approximatedFunctionId: Trajectory.trajectoryId,
            Trajectory.pointCount and, for each TrajectoryPoint (index sequenceNum - 1),
            Trajectory.points[i].pos.v[d] (VectorComponent.realValue), .sequenceNum, .timeOffsetMs, .isBreakPoint,
            .hasBlendingOverride, .bufferMode and .transitionMode (from blendingEnumId), .blendingMode
            (ParametricPathPoint.tolerance).
        </description>
        <in-parameters>
            <parameter name="deviceRuleSetId" required="true"/>
            <parameter name="deviceId"><description>Only the rules of this device.</description></parameter>
            <parameter name="deviceRuleId"><description>Only this rule.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="files" type="List"><description>Maps with name, content, priority and rowCount.</description></parameter>
            <parameter name="rowCount" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="devices" from="ec.resource.script('component://moqui-device/service/moqui/device/Devices.js')"/>
            <set field="answer" from="devices.execute('configExportFiles', context)"/>
            <set field="files" from="answer.files"/>
            <set field="rowCount" from="answer.rowCount"/>
        </actions>
    </service>

    <service verb="export" noun="DeviceConfig" authenticate="false" transaction="ignore">
        <description>
            Exports a device configuration recipe (Codesys txt-recipe format) to a device, so the device can work on its
            recipes offline. get#DeviceConfigExportFiles renders one file per DeviceRule priority,
            {ruleSetName}_p{priority:02d}.txt, with one name:=value line per parameter.

            The files go to the DeviceConnection of requestName: its transportConfig, file:directory or
            sftp://host:port/directory, with its options (see transfer#DeviceContent). Without a connection they go to
            the location in the property device_config_export_location and, when set, device_config_export_location_2.
            A failure is an error of the service, with status failed and errorMessage.

            Persistent trajectories (one Parameter per axis per waypoint, under a dedicated DeviceRuleSet) are exported
            by this same service; export#Trajectory is the ephemeral path.
        </description>
        <in-parameters>
            <parameter name="deviceRuleSetId" required="true"/>
            <parameter name="deviceId"><description>Optional. When set, limits the export to parameters belonging to
                this device's rules only.</description></parameter>
            <parameter name="deviceRuleId"><description>Optional. When set, limits the export to a single DeviceRule.
                Can be combined with deviceId for more specific filtering.</description></parameter>
            <parameter name="requestName" required="true"><description>The DeviceRequest of the export
                (requestTypeEnumId DrtConfigWrite).</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="status"><description>completed or failed.</description></parameter>
            <parameter name="files" type="List"><description>Maps with name, priority and rowCount.</description></parameter>
            <parameter name="rowCount" type="Integer"/>
            <parameter name="transferredFiles" type="List"/>
            <parameter name="errorMessage"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="moqui.device.DeviceRequest" value-field="request" cache="true">
                <field-map field-name="requestName"/>
            </entity-find-one>
            <if condition="!request"><return error="true" message="DeviceRequest ${requestName} not found."/></if>
            <service-call name="moqui.device.DeviceServices.get#DeviceConfigExportFiles" out-map="rendered"
                    in-map="{deviceRuleSetId:deviceRuleSetId, deviceId:deviceId, deviceRuleId:deviceRuleId}"/>
            <set field="files" from="(rendered.files || []).map(f => ({name:f.name, priority:f.priority, rowCount:f.rowCount}))"/>
            <set field="rowCount" from="rendered.rowCount || 0"/>
            <if condition="!files.length">
                <return error="true" message="DeviceRuleSet ${deviceRuleSetId} has no parameters or trajectory points to export."/>
            </if>
            <set field="destinations" from="[]"/>
            <if condition="request.connectionName"><then>
                <entity-find-one entity-name="moqui.device.DeviceConnection" value-field="connection" cache="true">
                    <field-map field-name="connectionName" from="request.connectionName"/>
                </entity-find-one>
                <if condition="!connection?.transportConfig">
                    <return error="true" message="DeviceConnection ${request.connectionName} of request ${requestName} has no transportConfig destination."/>
                </if>
                <set field="destinations" from="[{endpoint:connection.transportConfig, options:connection.options}]"/>
            </then><else>
                <set field="destinations" from="[System.getProperty('device_config_export_location'),
                        System.getProperty('device_config_export_location_2')].filter(l => l).map(l => ({endpoint:l}))"/>
            </else></if>
            <if condition="!destinations.length">
                <return error="true" message="DeviceRequest ${requestName} has no destination: set its DeviceConnection, or the property device_config_export_location."/>
            </if>
            <set field="transferredFiles" from="[]"/>
            <script>
                const devices = ec.resource.script('component://moqui-device/service/moqui/device/Devices.js')
                try {
                    for (const destination of destinations) {
                        transferredFiles = transferredFiles.concat(devices.execute('transferFiles',
                            {endpoint:destination.endpoint, options:destination.options, files:rendered.files}).transferredFiles)
                    }
                    status = 'completed'
                } catch (error) {
                    status = 'failed'
                    errorMessage = String(error &amp;&amp; error.message ? error.message : error)
                }
            </script>
            <log level="info" message="DeviceConfig export of rule set ${deviceRuleSetId} with request ${requestName}: ${status}, ${files.length} file(s), ${rowCount} line(s)"/>
            <if condition="status !== 'completed'">
                <message error="true">DeviceConfig export with request ${requestName} failed: ${errorMessage}</message>
            </if>
        </actions>
    </service>

    <service verb="get" noun="TransferDestination">
        <description>The destination of a file transfer DeviceRequest: its brokerUri, else the transportConfig of
            its DeviceConnection, with the options of the connection.</description>
        <in-parameters><parameter name="requestName" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="endpoint"/>
            <parameter name="options"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="moqui.device.DeviceRequest" value-field="target" cache="true">
                <field-map field-name="requestName"/>
            </entity-find-one>
            <if condition="!target"><return error="true" message="DeviceRequest ${requestName} not found."/></if>
            <if condition="target.connectionName">
                <entity-find-one entity-name="moqui.device.DeviceConnection" value-field="connection" cache="true">
                    <field-map field-name="connectionName" from="target.connectionName"/>
                </entity-find-one>
            </if>
            <set field="endpoint" from="target.brokerUri || connection?.transportConfig || null"/>
            <set field="options" from="connection?.options || null"/>
            <if condition="!endpoint">
                <return error="true" message="DeviceRequest ${requestName} has no destination: set its brokerUri or the transportConfig of its DeviceConnection."/>
            </if>
        </actions>
    </service>

    <service verb="get" noun="DeviceContentTransferFiles" type="rust" location="moqui_device::content::transfer_files">
        <description>The file of a DeviceContent, read through the resource facade, for a DrtContentTransfer
            DeviceRequest of the same device: a list with one map of name and bytes.</description>
        <in-parameters><parameter name="requestName" required="true"/><parameter name="deviceContentId" required="true"/></in-parameters>
        <out-parameters><parameter name="transferFiles" type="List"/></out-parameters>
    </service>

    <service verb="transfer" noun="DeviceContent" authenticate="false" transaction="ignore">
        <description>
            Transfers the file of a DeviceContent (G-Code, CNC program, part program, firmware, recipe, ...) to a device.
            The file is read from DeviceContent.contentLocation through the resource facade and written to the
            destination of the DrtContentTransfer DeviceRequest requestName.

            Destination (DeviceRequest.brokerUri, else DeviceConnection.transportConfig): file:directory, written through
            the resource facade, or sftp://host:port/directory, written with SftpClient. SFTP options, in
            DeviceConnection.options or the query of the destination: host-key-fingerprint (SHA256:..., required),
            username and password or private-key-file; usernameEnv and passwordEnv name an environment variable instead.
        </description>
        <in-parameters>
            <parameter name="deviceContentId" required="true"/>
            <parameter name="requestName" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="status"/>
            <parameter name="transferredFiles" type="List"/>
            <parameter name="errorMessage"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="moqui.device.DeviceRequest" value-field="request" cache="true">
                <field-map field-name="requestName"/>
            </entity-find-one>
            <if condition="!request"><return error="true" message="DeviceRequest ${requestName} not found."/></if>
            <service-call name="moqui.device.DeviceServices.get#DeviceContentTransferFiles" out-map="content"
                    in-map="{requestName:requestName, deviceContentId:deviceContentId}"/>
            <service-call name="moqui.device.DeviceServices.get#TransferDestination" out-map="destination"
                    in-map="{requestName:requestName}"/>
            <set field="devices" from="ec.resource.script('component://moqui-device/service/moqui/device/Devices.js')"/>
            <set field="answer" from="devices.execute('transferFiles', {endpoint:destination.endpoint,
                    options:destination.options, files:content.transferFiles})"/>
            <set field="status" value="completed"/>
            <set field="transferredFiles" from="answer.transferredFiles"/>
            <log level="info" message="DeviceContent ${deviceContentId} transferred with request ${requestName}: ${transferredFiles.join(', ')}"/>
        </actions>
    </service>

    <!-- ========== Trajectory Export ========== -->

    <service verb="get" noun="TrajectoryAxes">
        <description>
            Reads the waypoints of a planned trajectory (ApproximatedFunctionSample in sequenceNum order, each with its
            VectorComponent values) and returns one value list per axis. Axis names follow the vector space of the
            ApproximatedFunction: X,Y,Z,A,B,C for EngTcpPose6Dof, J1..J6 otherwise; a dimension beyond the sixth is
            named D and its index. TrajectoryAxisBinding is not used: this is the planned waypoint stream as it is.
        </description>
        <in-parameters>
            <parameter name="approximatedFunctionId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="axes" type="Map"/>
            <parameter name="waypointCount" type="Integer"/>
            <parameter name="vectorSpaceEnumId"/>
        </out-parameters>
        <actions>
            <entity-find entity-name="moqui.math.ApproximatedFunctionSample" list="samples">
                <econdition field-name="approximatedFunctionId"/>
                <order-by field-name="sequenceNum"/>
            </entity-find>
            <if condition="!samples?.length">
                <return error="true" message="No ApproximatedFunctionSample found for approximatedFunctionId ${approximatedFunctionId}."/>
            </if>
            <entity-find-one entity-name="moqui.math.ApproximatedFunction" value-field="approxFunc">
                <field-map field-name="approximatedFunctionId"/>
            </entity-find-one>
            <set field="vectorSpaceEnumId" from="approxFunc?.vectorSpaceEnumId || null"/>
            <set field="axisNames" from="vectorSpaceEnumId === 'EngTcpPose6Dof' ? ['X', 'Y', 'Z', 'A', 'B', 'C'] : ['J1', 'J2', 'J3', 'J4', 'J5', 'J6']"/>
            <set field="axes" from="{}"/>
            <set field="expectedDimensions" from="null"/>
            <iterate list="samples" entry="sample">
                <entity-find entity-name="moqui.math.VectorComponent" list="components">
                    <econdition field-name="vectorId" from="sample.sampleVectorId"/>
                    <order-by field-name="dimensionIndex"/>
                </entity-find>
                <set field="dimensions" from="Array.from(components).map(c => Number(String(c.dimensionIndex)))"/>
                <if condition="!components.length || dimensions.some((d, i) => !Number.isInteger(d) || d !== i)">
                    <return error="true" message="Trajectory ${approximatedFunctionId} has an incomplete or invalid waypoint vector."/>
                </if>
                <if condition="expectedDimensions != null &amp;&amp; expectedDimensions !== components.length">
                    <return error="true" message="Trajectory ${approximatedFunctionId} has inconsistent waypoint dimensions."/>
                </if>
                <set field="expectedDimensions" from="components.length"/>
                <iterate list="components" entry="comp">
                    <set field="dim" from="parseInt(comp.dimensionIndex, 10)"/>
                    <set field="axisKey" from="dim &lt; axisNames.length ? axisNames[dim] : 'D' + dim"/>
                    <if condition="comp.realValue == null || !Number.isFinite(Number(String(comp.realValue)))">
                        <return error="true" message="Trajectory ${approximatedFunctionId} has a missing or non-finite coordinate."/>
                    </if>
                    <!-- a decimal field is a Decimal object in the script: toNumber() reads it -->
                    <set field="axes[axisKey]" from="(axes[axisKey] || []).concat([(comp.realValue != null &amp;&amp; typeof comp.realValue.toNumber === 'function' ? comp.realValue.toNumber() : Number(comp.realValue))])"/>
                </iterate>
            </iterate>
            <set field="waypointCount" from="samples.length"/>
        </actions>
    </service>

    <service verb="export" noun="Trajectory" authenticate="false" transaction="ignore">
        <description>
            Publishes a planned trajectory for immediate execution (the ephemeral path; a recipe exported with
            export#DeviceConfig is the persistent one). The waypoints of the ApproximatedFunction (get#TrajectoryAxes) go
            out as one JSON message through run#DeviceRequest (the payload parameter): the DeviceRequest is an MQTT write
            without items, run by its runServiceName, whose brokerUri is the broker and whose query is the topic that
            MqttParameterSub on the PLC subscribes to; JsonToParametersMapper there expects the keys X,Y,Z,A,B,C (TCP pose) or J1..J6 (joint space).

            Message:
                {"requestName": "ROBOT_ARM_TRAJECTORY_EXPORT", "approximatedFunctionId": "100051",
                 "waypointCount": 10, "mqttTopic": "moqui/robot/arm1/trajectory",
                 "axes": {"X": [850.0, 860.0], "Y": [0.0, 20.0]}}
        </description>
        <in-parameters>
            <parameter name="approximatedFunctionId" required="true"/>
            <parameter name="requestName" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="status"/>
            <parameter name="errorMessage"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="moqui.device.DeviceRequest" value-field="request">
                <field-map field-name="requestName"/>
            </entity-find-one>
            <if condition="!request"><return error="true" message="DeviceRequest ${requestName} not found."/></if>
            <if condition="!request.query"><return error="true" message="DeviceRequest ${requestName} has no query: set it to the MQTT topic."/></if>
            <service-call name="moqui.device.DeviceServices.get#TrajectoryAxes" out-map="trajectory"
                    in-map="{approximatedFunctionId:approximatedFunctionId}"/>
            <log level="info" message="Exporting trajectory ${approximatedFunctionId} (${trajectory.waypointCount} waypoints) with request ${requestName}"/>
            <service-call name="moqui.device.DeviceServices.run#DeviceRequest" out-map="result"
                    in-map="{requestName:requestName, payload:{requestName:requestName, approximatedFunctionId:approximatedFunctionId,
                        waypointCount:trajectory.waypointCount, mqttTopic:request.query, axes:trajectory.axes}}"/>
            <set field="status" from="result.status"/>
            <set field="errorMessage" from="result.errorMessage"/>
        </actions>
    </service>

    <!-- ========== DeviceContent Services ========== -->

    <service verb="get" noun="DeviceContentLocation">
        <in-parameters>
            <parameter name="deviceId" required="true"/>
            <parameter name="contentTypeEnumIdList" type="List" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="contentLocation"/>
            <parameter name="deviceContent"/>
        </out-parameters>
        <actions>
            <iterate list="contentTypeEnumIdList" entry="contentTypeEnumId">
                <entity-find entity-name="moqui.device.DeviceContent" list="deviceContentList">
                    <econdition field-name="deviceId"/><econdition field-name="contentTypeEnumId"/>
                    <order-by field-name="-contentDate"/></entity-find>
                <if condition="(deviceContentList?.length > 0)">
                    <set field="deviceContent" from="deviceContentList[0]"/>
                    <break/>
                </if>
            </iterate>
            <set field="contentLocation" from="deviceContent ? deviceContent.contentLocation : null"/>
        </actions>
    </service>

    <service verb="create" noun="DeviceContent">
        <in-parameters>
            <auto-parameters entity-name="moqui.device.DeviceContent" include="nonpk">
                <exclude field-name="contentLocation"/></auto-parameters>
            <parameter name="deviceId" required="true"/>
            <parameter name="contentFile" type="org.apache.commons.fileupload2.core.FileItem"/>
        </in-parameters>
        <out-parameters><parameter name="deviceContentId"/></out-parameters>
        <actions>
            <service-call name="create#moqui.device.DeviceContent" in-map="context" out-map="context"/>
            <if condition="contentFile != null &amp;&amp; contentFile.size &gt; 0">
                <service-call name="moqui.device.DeviceServices.save#DeviceContentFile" in-map="context"/></if>
        </actions>
    </service>
    <service verb="update" noun="DeviceContent">
        <in-parameters>
            <parameter name="deviceContentId" required="true"/>
            <auto-parameters entity-name="moqui.device.DeviceContent" include="nonpk">
                <exclude field-name="contentLocation"/></auto-parameters>
            <parameter name="contentFile" type="org.apache.commons.fileupload2.core.FileItem"/>
        </in-parameters>
        <actions>
            <if condition="contentFile != null &amp;&amp; contentFile.size &gt; 0">
                <entity-find-one entity-name="moqui.device.DeviceContent" value-field="deviceContent"/>
                <service-call name="moqui.device.DeviceServices.save#DeviceContentFile" out-map="context"
                        in-map="Object.assign({}, context, {deviceId:deviceContent.deviceId, saveContentLocation:false})"/>
            </if>
            <service-call name="update#moqui.device.DeviceContent" in-map="context"/>
        </actions>
    </service>
    <service verb="save" noun="DeviceContentFile">
        <in-parameters>
            <parameter name="deviceContentId" required="true"/>
            <parameter name="deviceId" required="true"/>
            <parameter name="contentFile" type="org.apache.commons.fileupload2.core.FileItem" required="true"/>
            <parameter name="saveContentLocation" type="Boolean" default="true"/>
        </in-parameters>
        <out-parameters><parameter name="contentLocation"/></out-parameters>
        <actions>
            <set field="filename" from="contentFile.getName()"/>
            <if condition="!filename || ['.', '..'].includes(filename) || Array.from(filename).some(c => c === '/' || c === ':' || c.charCodeAt(0) === 92 || c.charCodeAt(0) &lt; 32 || c.charCodeAt(0) === 127)">
                <return error="true" message="A content upload requires a filename, not a path."/>
            </if>
            <entity-find-one entity-name="moqui.device.DeviceContent" value-field="contentOwner"/>
            <if condition="!contentOwner || contentOwner.deviceId !== deviceId">
                <return error="true" message="DeviceContent does not belong to the supplied device."/>
            </if>
            <if condition="ResourceReference.isTextFilename(filename)"><then>
                <set field="contentRoot" from="ec.user.getPreference('mantle.content.root') || 'dbresource://mantle/content'"/>
            </then><else>
                <set field="contentRoot" from="ec.user.getPreference('mantle.content.large.root') || 'dbresource://mantle/content'"/>
            </else></if>
            <set field="contentLocation" value="${contentRoot}/device/${deviceId}/content_${deviceContentId}/${filename}"/>

            <set field="docRr" from="ec.resource.getLocationReference(contentLocation)"/>
            <script>
                const fileStream = contentFile.getInputStream()
                try { docRr.putStream(fileStream) } finally { fileStream.close() }
            </script>

            <if condition="saveContentLocation"><service-call name="update#moqui.device.DeviceContent"
                    in-map="{deviceContentId:deviceContentId, contentLocation:contentLocation}"/></if>
        </actions>
    </service>

</services>

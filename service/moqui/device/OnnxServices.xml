<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="infer" noun="TrajectoryWaypoints" type="rust"
             location="moqui_device::services::infer_trajectory_waypoints">
        <description>In-process ONNX Runtime inference from the MathModel's registered local artifact. Requires the optional onnx Cargo feature.</description>
        <in-parameters>
            <parameter name="mathModelId" required="true"/>
            <parameter name="startPose" type="List" required="true"/>
            <parameter name="goalPose" type="List" required="true"/>
            <parameter name="onnxProfile" default-value="tcp12"/>
            <parameter name="obstacle" type="Map"/>
        </in-parameters>
        <out-parameters><parameter name="waypoints" type="List"/></out-parameters>
    </service>
</services>

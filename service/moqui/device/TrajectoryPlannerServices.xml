<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="call" noun="OpenVla">
        <description>
            Calls the OpenVLA REST endpoint and returns the predicted robot action.
            This is the thin transport wrapper around the real HTTP call: a JSON POST to openVlaLocation.
        </description>
        <in-parameters>
            <parameter name="openVlaLocation" required="true"/>
            <parameter name="instruction" required="true"/>
            <parameter name="image_base64" required="true"/>
            <parameter name="unnorm_key"/>
            <parameter name="do_sample" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="action" type="List"/>
            <parameter name="modelId"/>
            <parameter name="unnormKey"/>
        </out-parameters>
        <actions>
            <script><![CDATA[
                const restResponse = ec.service.rest().uri(openVlaLocation).method("POST").contentType("application/json")
                    .jsonObject({instruction, image_base64, unnorm_key, do_sample}).call()
                // the key is in the query, so the message names the endpoint without it
                if (restResponse.statusCode < 200 || restResponse.statusCode >= 300)
                    ec.message.addError(`OpenVLA error ${restResponse.statusCode} from ${openVlaLocation.split("?")[0]}`)
            ]]></script>
            <if condition="ec.message.hasError()"><return/></if>
            <set field="openVlaResponse" from="restResponse.jsonObject() || {}"/>
            <set field="action" from="openVlaResponse.action"/>
            <set field="modelId" from="openVlaResponse.modelId"/>
            <set field="unnormKey" from="openVlaResponse.unnormKey"/>
        </actions>
    </service>

    <service verb="call" noun="OpenVlaGrounding">
        <description>
            Calls an OpenVLA-compatible visual grounding endpoint and returns the
            object localization result in image space, with an optional target TCP pose (a JSON POST to
            openVlaLocation, as call#OpenVla).
        </description>
        <in-parameters>
            <parameter name="openVlaLocation" required="true"/>
            <parameter name="instruction" required="true"/>
            <parameter name="image_base64" required="true"/>
            <parameter name="return_target_pose" type="Boolean"/>
            <parameter name="target_pose_dimension" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="boundingBox" type="List"/>
            <parameter name="center" type="List"/>
            <parameter name="targetPose" type="List"/>
            <parameter name="objectLabel"/>
            <parameter name="confidence"/>
            <parameter name="coordinateSystem"/>
            <parameter name="modelId"/>
        </out-parameters>
        <actions>
            <script><![CDATA[
                const restResponse = ec.service.rest().uri(openVlaLocation).method("POST").contentType("application/json")
                    .jsonObject({instruction, image_base64, return_target_pose, target_pose_dimension}).call()
                // the key is in the query, so the message names the endpoint without it
                if (restResponse.statusCode < 200 || restResponse.statusCode >= 300)
                    ec.message.addError(`OpenVLA error ${restResponse.statusCode} from ${openVlaLocation.split("?")[0]}`)
            ]]></script>
            <if condition="ec.message.hasError()"><return/></if>
            <set field="openVlaResponse" from="restResponse.jsonObject() || {}"/>
            <set field="boundingBox" from="openVlaResponse.boundingBox"/>
            <set field="center" from="openVlaResponse.center"/>
            <set field="targetPose" from="openVlaResponse.targetPose"/>
            <set field="objectLabel" from="openVlaResponse.objectLabel"/>
            <set field="confidence" from="openVlaResponse.confidence"/>
            <set field="coordinateSystem" from="openVlaResponse.coordinateSystem"/>
            <set field="modelId" from="openVlaResponse.modelId"/>
        </actions>
    </service>

    <service verb="run" noun="OpenVla">
        <description>
            Resolves a device image from DeviceContent and delegates the inference call
            to OpenVLA through the remote-rest service wrapper.
        </description>
        <in-parameters>
            <parameter name="deviceId" required="true"/>
            <parameter name="prompt" required="true"/>
            <parameter name="deviceContentId"/>
            <parameter name="openVlaBaseUrl" default-value="http://openvla:8000"/>
            <parameter name="apiKey"/>
            <parameter name="unnormKey"/>
            <parameter name="doSample" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="action" type="List"/>
            <parameter name="modelId"/>
            <parameter name="unnormKey"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="moqui.device.Device" value-field="device">
                <field-map field-name="deviceId"/>
            </entity-find-one>
            <if condition="!device">
                <return error="true" message="Device ${deviceId} not found"/>
            </if>

            <if condition="deviceContentId">
                <then>
                    <entity-find-one entity-name="moqui.device.DeviceContent" value-field="deviceContent">
                        <field-map field-name="deviceContentId"/>
                    </entity-find-one>
                    <if condition="!deviceContent || deviceContent.deviceId != deviceId">
                        <return error="true" message="DeviceContent ${deviceContentId} not found for device ${deviceId}"/>
                    </if>
                    <set field="imageLocation" from="deviceContent.contentLocation"/>
                </then>
                <else>
                    <service-call name="moqui.device.DeviceServices.get#DeviceContentLocation"
                            in-map="{deviceId:deviceId, contentTypeEnumIdList:['DCntImage']}" out-map="context"/>
                    <if condition="!deviceContent">
                        <return error="true" message="No image DeviceContent found for device ${deviceId}"/>
                    </if>
                    <set field="imageLocation" from="contentLocation"/>
                </else>
            </if>

            <if condition="!imageLocation">
                <return error="true" message="DeviceContent ${deviceContent ? deviceContent.deviceContentId : deviceContentId} has no contentLocation"/>
            </if>

            <set field="imageBase64" from="ec.getTool('TrajectoryGenerator').imageBase64(imageLocation)"/>
            <set field="baseUrl" from="(openVlaBaseUrl || 'http://openvla:8000').replace(/\/+$/, '')"/>
            <set field="openVlaLocation" from="apiKey ? baseUrl + '/act?apiKey=' + encodeURIComponent(apiKey) : baseUrl + '/act'"/>

            <service-call name="moqui.device.TrajectoryPlannerServices.call#OpenVla"
                    in-map="{openVlaLocation:openVlaLocation, instruction:prompt, image_base64:imageBase64,
                            unnorm_key:unnormKey, do_sample:doSample}"
                    out-map="openVlaResult"/>

            <set field="action" from="openVlaResult.action"/>
            <set field="modelId" from="openVlaResult.modelId"/>
            <set field="unnormKey" from="openVlaResult.unnormKey"/>
        </actions>
    </service>

    <service verb="run" noun="OpenVlaGrounding">
        <description>
            Resolves an image from DeviceContent, calls an OpenVLA-compatible visual
            grounding endpoint, and optionally persists the geometric result as
            Vector / VectorComponent records. The returned targetPose can be passed
            directly as goalPose to run#RobotArmTrajectoryPlanner.
        </description>
        <in-parameters>
            <parameter name="deviceId" required="true"/>
            <parameter name="prompt" required="true"/>
            <parameter name="deviceContentId"/>
            <parameter name="openVlaBaseUrl" default-value="http://openvla:8000"/>
            <parameter name="apiKey"/>
            <parameter name="returnTargetPose" type="Boolean" default-value="false"/>
            <parameter name="targetPoseDimension" type="Integer" default-value="6"/>
            <parameter name="saveResult" type="Boolean" default-value="false"/>
            <parameter name="saveBoundingBox" type="Boolean" default-value="true"/>
            <parameter name="saveCenter" type="Boolean" default-value="true"/>
            <parameter name="saveTargetPose" type="Boolean" default-value="true"/>
            <parameter name="imageVectorSpaceEnumId" default-value="EuclideanSpace2D"/>
            <parameter name="targetPoseVectorSpaceEnumId" default-value="EngTcpPose6Dof"/>
        </in-parameters>
        <out-parameters>
            <parameter name="boundingBox" type="List"/>
            <parameter name="center" type="List"/>
            <parameter name="targetPose" type="List"/>
            <parameter name="goalPose" type="List"/>
            <parameter name="objectLabel"/>
            <parameter name="confidence"/>
            <parameter name="coordinateSystem"/>
            <parameter name="modelId"/>
            <parameter name="boundingBoxMinVectorId"/>
            <parameter name="boundingBoxMaxVectorId"/>
            <parameter name="centerVectorId"/>
            <parameter name="targetPoseVectorId"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="moqui.device.Device" value-field="device">
                <field-map field-name="deviceId"/>
            </entity-find-one>
            <if condition="!device">
                <return error="true" message="Device ${deviceId} not found"/>
            </if>

            <if condition="deviceContentId">
                <then>
                    <entity-find-one entity-name="moqui.device.DeviceContent" value-field="deviceContent">
                        <field-map field-name="deviceContentId"/>
                    </entity-find-one>
                    <if condition="!deviceContent || deviceContent.deviceId != deviceId">
                        <return error="true" message="DeviceContent ${deviceContentId} not found for device ${deviceId}"/>
                    </if>
                    <set field="imageLocation" from="deviceContent.contentLocation"/>
                </then>
                <else>
                    <service-call name="moqui.device.DeviceServices.get#DeviceContentLocation"
                            in-map="{deviceId:deviceId, contentTypeEnumIdList:['DCntImage']}" out-map="context"/>
                    <if condition="!deviceContent">
                        <return error="true" message="No image DeviceContent found for device ${deviceId}"/>
                    </if>
                    <set field="imageLocation" from="contentLocation"/>
                </else>
            </if>

            <if condition="!imageLocation">
                <return error="true" message="DeviceContent ${deviceContent ? deviceContent.deviceContentId : deviceContentId} has no contentLocation"/>
            </if>

            <set field="generator" from="ec.getTool('TrajectoryGenerator')"/>
            <set field="imageBase64" from="generator.imageBase64(imageLocation)"/>
            <set field="baseUrl" from="(openVlaBaseUrl || 'http://openvla:8000').replace(/\/+$/, '')"/>
            <set field="openVlaLocation" from="apiKey ? baseUrl + '/ground?apiKey=' + encodeURIComponent(apiKey) : baseUrl + '/ground'"/>

            <service-call name="moqui.device.TrajectoryPlannerServices.call#OpenVlaGrounding"
                    in-map="{openVlaLocation:openVlaLocation, instruction:prompt, image_base64:imageBase64,
                            return_target_pose:returnTargetPose, target_pose_dimension:targetPoseDimension}"
                    out-map="groundingResult"/>

            <set field="boundingBox" from="generator.normalizeNumberList(groundingResult.boundingBox, 'boundingBox', 4)"/>
            <set field="center" from="generator.normalizeNumberList(groundingResult.center, 'center', 2)"/>
            <set field="targetPose" from="generator.normalizeNumberList(groundingResult.targetPose, 'targetPose',
                    returnTargetPose ? (targetPoseDimension || 6) : null)"/>
            <if condition="!boundingBox?.length &amp;&amp; !center?.length &amp;&amp; !targetPose?.length">
                <return error="true" message="OpenVLA grounding response for device ${deviceId} did not contain boundingBox, center, or targetPose."/>
            </if>
            <set field="goalPose" from="targetPose"/>
            <set field="objectLabel" from="groundingResult.objectLabel"/>
            <set field="confidence" from="groundingResult.confidence"/>
            <set field="coordinateSystem" from="groundingResult.coordinateSystem || 'image-pixel'"/>
            <set field="modelId" from="groundingResult.modelId"/>

            <if condition="saveResult">
                <script><![CDATA[
                    const createVector = (name, description, vectorSpaceEnumId, purposeEnumId, values) => {
                        if (!values || !values.length) return null
                        const vectorValue = ec.entity.makeValue("moqui.math.Vector")
                        const vectorFields = {vectorTypeEnumId: "VtOrdinary", purposeEnumId, vectorSpaceEnumId, name,
                            description, dimension: values.length}
                        for (const [field, value] of Object.entries(vectorFields)) vectorValue.set(field, value)
                        vectorValue.setSequencedIdPrimary()
                        vectorValue.create()
                        values.forEach((value, idx) => {
                            const componentValue = ec.entity.makeValue("moqui.math.VectorComponent")
                            const componentFields = {vectorId: vectorValue.vectorId, dimensionIndex: idx,
                                componentTypeEnumId: "VctCanonical", realValue: value}
                            for (const [field, fieldValue] of Object.entries(componentFields)) componentValue.set(field, fieldValue)
                            componentValue.setSequencedIdPrimary()
                            componentValue.create()
                        })
                        return vectorValue.vectorId
                    }
                    const imageNote = `device ${deviceId}, image ${deviceContent.deviceContentId}`
                ]]></script>
                <if condition="saveBoundingBox &amp;&amp; boundingBox?.length">
                    <set field="boundingBoxMinVectorId" from="createVector('bbox_min_' + deviceId,
                            'Visual grounding bounding-box min corner for ' + imageNote, imageVectorSpaceEnumId || 'EuclideanSpace2D',
                            'VpPosition', [boundingBox[0], boundingBox[1]])"/>
                    <set field="boundingBoxMaxVectorId" from="createVector('bbox_max_' + deviceId,
                            'Visual grounding bounding-box max corner for ' + imageNote, imageVectorSpaceEnumId || 'EuclideanSpace2D',
                            'VpPosition', [boundingBox[2], boundingBox[3]])"/>
                </if>
                <if condition="saveCenter &amp;&amp; center?.length">
                    <set field="centerVectorId" from="createVector('bbox_center_' + deviceId,
                            'Visual grounding center point for ' + imageNote, imageVectorSpaceEnumId || 'EuclideanSpace2D',
                            'VpPosition', center)"/>
                </if>
                <if condition="saveTargetPose &amp;&amp; targetPose?.length">
                    <set field="targetPoseVectorId" from="createVector('target_pose_' + deviceId,
                            'Target TCP pose inferred from visual grounding for ' + imageNote,
                            targetPoseVectorSpaceEnumId || 'EngTcpPose6Dof', 'VpPosition', targetPose)"/>
                </if>
            </if>
        </actions>
    </service>

    <!-- ========== Trajectory Planner ========== -->

    <service verb="run" noun="RobotArmTrajectoryPlanner">
        <description>
            Run a 6-DOF robot TCP waypoint planner using an ONNX model (ONNX Runtime, through the TrajectoryGenerator
            tool).

            The model accepts [tcp_start(6) || tcp_goal(6)] (12 inputs) and produces
            N_WAYPOINTS x 6 TCP poses (flat output), aligned with the PLC waypoint
            space used by PLCopen Part 4 coordinated-motion FBs such as
            MC_MoveLinearAbsolute and MC_MoveCircularAbsolute.

            Persists results to:
                Vector / VectorComponent        — per-waypoint TCP poses + tcp_start/tcp_goal
                ApproximatedFunction            — parent function container
                ParametricPath                  — path-level metadata
                Trajectory                      — time-tagged motion
                ApproximatedFunctionSample      — one sample per waypoint
                ParametricPathPoint             — path point per sample
                TrajectoryPoint                 — time offset per sample
                MathModelRun                    — execution record
                MathModelPerf                   — latency / throughput counters
                MathModelData                   — links model to trajectory + input vectors

            The ONNX model file is resolved from MathModelDefContent.contentLocation
            (e.g. component://moqui-device/data/ml/trajectory_planner.onnx).
            The current bundled model must be retrained/exported in the same TCP pose
            space (X,Y,Z,A,B,C) to match this service contract.
        </description>
        <in-parameters>
            <parameter name="mathModelId" required="true">
                <description>ID of the MathModel instance to use for inference.</description>
            </parameter>
            <parameter name="startPose" type="List" required="true">
                <description>6 TCP pose values [X,Y,Z,A,B,C] — start pose in the same space used by the PLC.</description>
            </parameter>
            <parameter name="goalPose" type="List" required="true">
                <description>6 TCP pose values [X,Y,Z,A,B,C] — goal pose in the same space used by the PLC.</description>
            </parameter>
            <parameter name="trajectoryName" type="String" default-value=""/>
        </in-parameters>
        <out-parameters>
            <parameter name="mathModelRunId"/>
            <parameter name="approximatedFunctionId"/>
            <parameter name="mathModelPerfId"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="moqui.math.MathModel" value-field="mathModel">
                <field-map field-name="mathModelId"/>
            </entity-find-one>
            <if condition="!mathModel">
                <return error="true" message="MathModel ${mathModelId} not found"/>
            </if>

            <entity-find-one entity-name="moqui.math.MathModelDefContent" value-field="onnxContent">
                <field-map field-name="mathModelDefId" from="mathModel.mathModelDefId"/>
                <field-map field-name="contentTypeEnumId" value="MmCntOnnx"/>
            </entity-find-one>
            <if condition="!onnxContent">
                <return error="true" message="No ONNX content for MathModelDef ${mathModel.mathModelDefId}"/>
            </if>

            <set field="generator" from="ec.getTool('TrajectoryGenerator')"/>
            <set field="startPoseList" from="generator.normalizePoseVector(startPose, 'startPose')"/>
            <set field="goalPoseList" from="generator.normalizePoseVector(goalPose, 'goalPose')"/>
            <set field="mathModelRunParameters" from="JSON.stringify({startPose: startPoseList, goalPose: goalPoseList})"/>
            <set field="trajectoryLabel" from="trajectoryName || null"/>

            <set field="mathModelRunFields" from="{mathModelId: mathModelId, startTime: ec.user.nowTimestamp,
                parameters: mathModelRunParameters, hasError: 'N'}"/>
            <entity-make-value entity-name="moqui.math.MathModelRun" value-field="runVal" map="mathModelRunFields"/>
            <set field="t0" from="Date.now()"/>
            <entity-sequenced-id-primary value-field="runVal"/>
            <entity-create value-field="runVal"/>
            <set field="runId" from="runVal.mathModelRunId"/>

            <script><![CDATA[
                let inference
                try {
                    inference = generator.runInference(onnxContent.contentLocation, startPoseList, goalPoseList)
                } catch (error) {
                    const runRef = ec.entity.find("moqui.math.MathModelRun").condition("mathModelRunId", runId).one()
                    if (runRef) {
                        runRef.set("endDate", ec.user.nowTimestamp)
                        runRef.set("runningTimeMillis", Date.now() - t0)
                        runRef.set("hasError", "Y")
                        runRef.set("errors", error && error.message ? error.message : String(error))
                        runRef.update()
                    }
                    throw error
                }
            ]]></script>
            <set field="waypoints" from="inference.waypoints"/>
            <set field="waypointCount" from="inference.waypointCount"/>
            <set field="inferenceLatencyMs" from="inference.inferenceLatencyMs || 0"/>

            <set field="trajectoryLabel" from="trajectoryLabel || 'AI Trajectory ' + runId"/>
            <set field="approximatedFunctionFields" from="{vectorSpaceEnumId: 'EngTcpPose6Dof', codomainTypeEnumId: 'AfctVector',
                dataStorageEnumId: 'AfdsPointTable', purposeEnumId: 'AfpRobotMotion', interpolationEnumId: 'AfiAIPath',
                name: trajectoryLabel, description: '6-DOF TCP waypoint trajectory from AI planner'}"/>
            <entity-make-value entity-name="moqui.math.ApproximatedFunction" value-field="approximatedFunctionValue" map="approximatedFunctionFields"/>
            <entity-sequenced-id-primary value-field="approximatedFunctionValue"/>
            <entity-create value-field="approximatedFunctionValue"/>
            <set field="approximatedFunctionId" from="approximatedFunctionValue.approximatedFunctionId"/>

            <set field="parametricPathFields" from="{approximatedFunctionId: approximatedFunctionId, profileEnumId: 'PppfTrajectoryProfile'}"/>
            <entity-make-value entity-name="moqui.math.ParametricPath" value-field="parametricPathValue" map="parametricPathFields"/>
            <entity-create value-field="parametricPathValue"/>

            <set field="trajectoryFields" from="{approximatedFunctionId: approximatedFunctionId, actuationTypeEnumId: 'PtaVirtual',
                controlMethodEnumId: 'PtcmNNControl'}"/>
            <entity-make-value entity-name="moqui.math.Trajectory" value-field="trajectoryValue" map="trajectoryFields"/>
            <entity-create value-field="trajectoryValue"/>

            <set field="stepMs" from="waypointCount > 1 ? 1000.0 / (waypointCount - 1) : 0.0"/>
            <set field="waypointIndex" from="0" type="Integer"/>
            <iterate list="waypoints" entry="waypoint">
                <set field="waypointVectorFields" from="{vectorTypeEnumId: 'VtOrdinary', purposeEnumId: 'VpPosition', dimension: 6}"/>
                <entity-make-value entity-name="moqui.math.Vector" value-field="waypointVectorValue" map="waypointVectorFields"/>
                <entity-sequenced-id-primary value-field="waypointVectorValue"/>
                <entity-create value-field="waypointVectorValue"/>
                <set field="waypointVectorId" from="waypointVectorValue.vectorId"/>

                <set field="poseIndex" from="0" type="Integer"/>
                <iterate list="waypoint" entry="poseValue">
                    <set field="waypointComponentFields" from="{vectorId: waypointVectorId, dimensionIndex: poseIndex,
                        componentTypeEnumId: 'VctCanonical', realValue: poseValue}"/>
                    <entity-make-value entity-name="moqui.math.VectorComponent" value-field="waypointComponentValue" map="waypointComponentFields"/>
                    <entity-sequenced-id-primary value-field="waypointComponentValue"/>
                    <entity-create value-field="waypointComponentValue"/>
                    <set field="poseIndex" from="poseIndex + 1" type="Integer"/>
                </iterate>

                <set field="sampleTypeEnumId" from="waypointIndex == 0 ? 'AfstStartPoint' : (waypointIndex == (waypointCount - 1) ? 'AfstEndPoint' : 'AfstWaypoint')"/>
                <set field="sampleFields" from="{approximatedFunctionId: approximatedFunctionId, sampleCode: 'WP' + String(waypointIndex).padStart(4, '0'),
                    sampleName: 'Waypoint ' + waypointIndex, sequenceNum: waypointIndex, sampleTypeEnumId: sampleTypeEnumId,
                    sampleVectorId: waypointVectorId}"/>
                <entity-make-value entity-name="moqui.math.ApproximatedFunctionSample" value-field="sampleValue" map="sampleFields"/>
                <entity-sequenced-id-secondary value-field="sampleValue"/>
                <entity-create value-field="sampleValue"/>
                <set field="sampleId" from="sampleValue.approximatedFunctionSampleId"/>

                <set field="pathPointFields" from="{approximatedFunctionId: approximatedFunctionId, approximatedFunctionSampleId: sampleId}"/>
                <entity-make-value entity-name="moqui.math.ParametricPathPoint" value-field="pathPointValue" map="pathPointFields"/>
                <entity-create value-field="pathPointValue"/>

                <set field="trajectoryPointFields" from="{approximatedFunctionId: approximatedFunctionId,
                    approximatedFunctionSampleId: sampleId, pointTimeOffsetMillis: waypointIndex * stepMs}"/>
                <entity-make-value entity-name="moqui.math.TrajectoryPoint" value-field="trajectoryPointValue" map="trajectoryPointFields"/>
                <entity-create value-field="trajectoryPointValue"/>

                <set field="waypointIndex" from="waypointIndex + 1" type="Integer"/>
            </iterate>

            <set field="inputVectorList" from="[{name: 'tcp_start', values: startPoseList}, {name: 'tcp_goal', values: goalPoseList}]"/>
            <set field="inputVectorIdList" from="[]"/>
            <iterate list="inputVectorList" entry="inputVector">
                <set field="inputVectorFields" from="{vectorTypeEnumId: 'VtOrdinary', purposeEnumId: 'VpPosition',
                    dimension: 6, name: inputVector.name}"/>
                <entity-make-value entity-name="moqui.math.Vector" value-field="inputVectorValue" map="inputVectorFields"/>
                <entity-sequenced-id-primary value-field="inputVectorValue"/>
                <entity-create value-field="inputVectorValue"/>
                <set field="inputVectorIdList" from="inputVectorIdList.concat([inputVectorValue.vectorId])"/>

                <set field="poseIndex" from="0" type="Integer"/>
                <iterate list="inputVector.values" entry="poseValue">
                    <set field="inputVectorComponentFields" from="{vectorId: inputVectorValue.vectorId, dimensionIndex: poseIndex,
                        componentTypeEnumId: 'VctCanonical', realValue: poseValue}"/>
                    <entity-make-value entity-name="moqui.math.VectorComponent" value-field="inputVectorComponentValue" map="inputVectorComponentFields"/>
                    <entity-sequenced-id-primary value-field="inputVectorComponentValue"/>
                    <entity-create value-field="inputVectorComponentValue"/>
                    <set field="poseIndex" from="poseIndex + 1" type="Integer"/>
                </iterate>
            </iterate>

            <set field="startVectorId" from="inputVectorIdList[0]"/>
            <set field="goalVectorId" from="inputVectorIdList[1]"/>

            <set field="outputModelDataFields" from="{mathModelId: mathModelId, dataTypeEnumId: 'MmdtApproxFunc',
                purposeEnumId: 'MmdpModelOutputs', generatedByRunId: runId, approximatedFunctionId: approximatedFunctionId,
                sequenceNum: 1}"/>
            <entity-make-value entity-name="moqui.math.MathModelData" value-field="outputModelDataValue" map="outputModelDataFields"/>
            <entity-sequenced-id-primary value-field="outputModelDataValue"/>
            <entity-create value-field="outputModelDataValue"/>

            <set field="startModelDataFields" from="{mathModelId: mathModelId, dataTypeEnumId: 'MmdtVector',
                purposeEnumId: 'MmdpModelInputs', generatedByRunId: runId, vectorId: startVectorId, sequenceNum: 2}"/>
            <entity-make-value entity-name="moqui.math.MathModelData" value-field="startModelDataValue" map="startModelDataFields"/>
            <entity-sequenced-id-primary value-field="startModelDataValue"/>
            <entity-create value-field="startModelDataValue"/>

            <set field="goalModelDataFields" from="{mathModelId: mathModelId, dataTypeEnumId: 'MmdtVector',
                purposeEnumId: 'MmdpModelInputs', generatedByRunId: runId, vectorId: goalVectorId, sequenceNum: 3}"/>
            <entity-make-value entity-name="moqui.math.MathModelData" value-field="goalModelDataValue" map="goalModelDataFields"/>
            <entity-sequenced-id-primary value-field="goalModelDataValue"/>
            <entity-create value-field="goalModelDataValue"/>

            <set field="elapsed" from="Date.now() - t0"/>
            <set field="totalDurationSec" from="elapsed > 0 ? elapsed / 1000.0 : 0.001"/>
            <set field="resultsJson" from="JSON.stringify({approximatedFunctionId: approximatedFunctionId, waypointCount: waypointCount})"/>
            <entity-find-one entity-name="moqui.math.MathModelRun" value-field="runRef">
                <field-map field-name="mathModelRunId" from="runId"/>
            </entity-find-one>
            <set field="runRef.endDate" from="ec.user.nowTimestamp"/>
            <set field="runRef.runningTimeMillis" from="elapsed"/>
            <set field="runRef.approximatedFunctionId" from="approximatedFunctionId"/>
            <set field="runRef.results" from="resultsJson"/>
            <entity-update value-field="runRef"/>

            <set field="perfFields" from="{mathModelRunId: runId, totalDurationSec: totalDurationSec,
                inferenceLatencyMs: inferenceLatencyMs, throughputSamplesSec: waypointCount / totalDurationSec}"/>
            <entity-make-value entity-name="moqui.math.MathModelPerf" value-field="perfValue" map="perfFields"/>
            <entity-sequenced-id-primary value-field="perfValue"/>
            <entity-create value-field="perfValue"/>
            <set field="mathModelRunId" from="runId"/>
            <set field="mathModelPerfId" from="perfValue.mathModelPerfId"/>
        </actions>
    </service>
</services>

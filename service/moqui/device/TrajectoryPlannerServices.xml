<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="call" noun="InferenceEndpoint">
        <description>
            Posts a JSON body to an inference provider (OpenVLA, a remote trajectory planner) and returns the JSON
            response. The provider key goes in the X-API-Key header, never in the body or the URL. A remote-rest
            service cannot set that header, so the call uses ec.service.rest().
        </description>
        <in-parameters>
            <parameter name="url" required="true"/>
            <parameter name="apiKey"/>
            <parameter name="payload" type="Map"/>
            <parameter name="timeout" type="Integer" default-value="30"/>
        </in-parameters>
        <out-parameters>
            <parameter name="response" type="Map"/>
        </out-parameters>
        <actions><script><![CDATA[
            const client = ec.service.rest().uri(url).method("POST")
                .contentType("application/json").jsonObject(payload || {}).timeout(timeout || 30);
            if (apiKey) client.addHeader("X-API-Key", apiKey);
            const result = client.call();
            if (result.statusCode < 200 || result.statusCode >= 300) {
                ec.message.addError(`Inference provider returned HTTP ${result.statusCode}.`);
                return;
            }
            response = result.jsonObject();
        ]]></script></actions>
    </service>

    <service verb="call" noun="OpenVla">
        <description>
            Calls the OpenVLA REST endpoint and returns the predicted robot action.
            This is the thin transport wrapper around the real HTTP call.
        </description>
        <in-parameters>
            <parameter name="openVlaLocation" required="true"/>
            <parameter name="apiKey"/>
            <parameter name="instruction" required="true"/>
            <parameter name="image_base64" required="true"/>
            <parameter name="unnorm_key"/>
            <parameter name="do_sample" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="action" type="List"/>
            <parameter name="modelId"/>
            <parameter name="unnormKey"/>
        </out-parameters>
        <actions>
            <service-call name="moqui.device.TrajectoryPlannerServices.call#InferenceEndpoint" out-map="output"
                    in-map="{url:openVlaLocation, apiKey:apiKey, payload:{instruction:instruction, image_base64:image_base64,
                        unnorm_key:unnorm_key, do_sample:do_sample}}"/>
            <set field="action" from="output.response?.action"/>
            <set field="modelId" from="output.response?.modelId"/>
            <set field="unnormKey" from="output.response?.unnormKey"/>
        </actions>
    </service>

    <service verb="call" noun="OpenVlaGrounding">
        <description>
            Calls an OpenVLA-compatible visual grounding endpoint and returns the
            object localization result in image space, with an optional target TCP pose.
        </description>
        <in-parameters>
            <parameter name="openVlaLocation" required="true"/>
            <parameter name="apiKey"/>
            <parameter name="instruction" required="true"/>
            <parameter name="image_base64" required="true"/>
            <parameter name="return_target_pose" type="Boolean"/>
            <parameter name="target_pose_dimension" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="boundingBox" type="List"/>
            <parameter name="center" type="List"/>
            <parameter name="targetPose" type="List"/>
            <parameter name="objectLabel"/>
            <parameter name="confidence"/>
            <parameter name="coordinateSystem"/>
            <parameter name="modelId"/>
        </out-parameters>
        <actions>
            <service-call name="moqui.device.TrajectoryPlannerServices.call#InferenceEndpoint" out-map="output"
                    in-map="{url:openVlaLocation, apiKey:apiKey, payload:{instruction:instruction, image_base64:image_base64,
                        return_target_pose:return_target_pose, target_pose_dimension:target_pose_dimension}}"/>
            <set field="data" from="output.response || {}"/>
            <set field="boundingBox" from="data.boundingBox"/>
            <set field="center" from="data.center"/>
            <set field="targetPose" from="data.targetPose"/>
            <set field="objectLabel" from="data.objectLabel"/>
            <set field="confidence" from="data.confidence"/>
            <set field="coordinateSystem" from="data.coordinateSystem"/>
            <set field="modelId" from="data.modelId"/>
        </actions>
    </service>

    <service verb="run" noun="OpenVla">
        <description>
            Resolves a device image from DeviceContent and delegates the inference call
            to OpenVLA through call#OpenVla.
        </description>
        <in-parameters>
            <parameter name="deviceId" required="true"/>
            <parameter name="prompt" required="true"/>
            <parameter name="deviceContentId"/>
            <parameter name="openVlaBaseUrl" default-value="http://openvla:8000"/>
            <parameter name="apiKey"/>
            <parameter name="unnormKey"/>
            <parameter name="doSample" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="action" type="List"/>
            <parameter name="modelId"/>
            <parameter name="unnormKey"/>
        </out-parameters>
        <actions>
            <service-call name="moqui.device.TrajectoryPlannerServices.get#DeviceImage" out-map="image"
                    in-map="{deviceId:deviceId, deviceContentId:deviceContentId}"/>
            <set field="deviceContent" from="image.deviceContent"/>
            <set field="openVlaLocation" from="(openVlaBaseUrl || 'http://openvla:8000').replace(/\/+$/, '') + '/act'"/>

            <service-call name="moqui.device.TrajectoryPlannerServices.call#OpenVla"
                    in-map="{openVlaLocation:openVlaLocation, apiKey:apiKey, instruction:prompt, image_base64:image.imageBase64,
                            unnorm_key:unnormKey, do_sample:doSample}"
                    out-map="openVlaResult"/>
            <set field="action" from="openVlaResult.action"/>
            <set field="modelId" from="openVlaResult.modelId"/>
            <set field="unnormKey" from="openVlaResult.unnormKey"/>
        </actions>
    </service>

    <service verb="run" noun="OpenVlaGrounding">
        <description>
            Resolves an image from DeviceContent, calls an OpenVLA-compatible visual
            grounding endpoint, and optionally persists the geometric result as
            Vector / VectorComponent records. The returned targetPose can be passed
            directly as goalPose to run#RobotArmTrajectoryPlanner.
        </description>
        <in-parameters>
            <parameter name="deviceId" required="true"/>
            <parameter name="prompt" required="true"/>
            <parameter name="deviceContentId"/>
            <parameter name="openVlaBaseUrl" default-value="http://openvla:8000"/>
            <parameter name="apiKey"/>
            <parameter name="returnTargetPose" type="Boolean" default-value="false"/>
            <parameter name="targetPoseDimension" type="Integer" default-value="6"/>
            <parameter name="saveResult" type="Boolean" default-value="false"/>
            <parameter name="saveBoundingBox" type="Boolean" default-value="true"/>
            <parameter name="saveCenter" type="Boolean" default-value="true"/>
            <parameter name="saveTargetPose" type="Boolean" default-value="true"/>
            <parameter name="imageVectorSpaceEnumId" default-value="EuclideanSpace2D"/>
            <parameter name="targetPoseVectorSpaceEnumId" default-value="EngTcpPose6Dof"/>
        </in-parameters>
        <out-parameters>
            <parameter name="boundingBox" type="List"/>
            <parameter name="center" type="List"/>
            <parameter name="targetPose" type="List"/>
            <parameter name="goalPose" type="List"/>
            <parameter name="objectLabel"/>
            <parameter name="confidence"/>
            <parameter name="coordinateSystem"/>
            <parameter name="modelId"/>
            <parameter name="boundingBoxMinVectorId"/>
            <parameter name="boundingBoxMaxVectorId"/>
            <parameter name="centerVectorId"/>
            <parameter name="targetPoseVectorId"/>
        </out-parameters>
        <actions>
            <service-call name="moqui.device.TrajectoryPlannerServices.get#DeviceImage" out-map="image"
                    in-map="{deviceId:deviceId, deviceContentId:deviceContentId}"/>
            <set field="deviceContent" from="image.deviceContent"/>
            <set field="openVlaLocation" from="(openVlaBaseUrl || 'http://openvla:8000').replace(/\/+$/, '') + '/ground'"/>

            <service-call name="moqui.device.TrajectoryPlannerServices.call#OpenVlaGrounding"
                    in-map="{openVlaLocation:openVlaLocation, apiKey:apiKey, instruction:prompt, image_base64:image.imageBase64,
                            return_target_pose:returnTargetPose, target_pose_dimension:targetPoseDimension}"
                    out-map="groundingResult"/>

            <service-call name="moqui.device.TrajectoryPlannerServices.check#NumberList" out-map="boundingBoxCheck"
                    in-map="{values:groundingResult.boundingBox, fieldName:'boundingBox', minSize:4}"/>
            <service-call name="moqui.device.TrajectoryPlannerServices.check#NumberList" out-map="centerCheck"
                    in-map="{values:groundingResult.center, fieldName:'center', minSize:2}"/>
            <service-call name="moqui.device.TrajectoryPlannerServices.check#NumberList" out-map="targetPoseCheck"
                    in-map="{values:groundingResult.targetPose, fieldName:'targetPose',
                        minSize:returnTargetPose ? (targetPoseDimension || 6) : null}"/>
            <if condition="!boundingBoxCheck.numbers &amp;&amp; !centerCheck.numbers &amp;&amp; !targetPoseCheck.numbers">
                <return error="true" message="OpenVLA grounding response for device ${deviceId} did not contain boundingBox, center, or targetPose."/>
            </if>
            <set field="boundingBox" from="boundingBoxCheck.numbers"/>
            <set field="center" from="centerCheck.numbers"/>
            <set field="targetPose" from="targetPoseCheck.numbers"/>
            <set field="goalPose" from="targetPoseCheck.numbers"/>
            <set field="objectLabel" from="groundingResult.objectLabel"/>
            <set field="confidence" from="groundingResult.confidence"/>
            <set field="coordinateSystem" from="groundingResult.coordinateSystem || 'image-pixel'"/>
            <set field="modelId" from="groundingResult.modelId"/>

            <if condition="saveResult">
                <set field="imageLabel" from="deviceContent?.deviceContentId || ''"/>
                <if condition="saveBoundingBox &amp;&amp; boundingBox">
                    <service-call name="moqui.device.TrajectoryPlannerServices.create#PoseVector" out-map="minVector"
                            in-map="{name:'bbox_min_' + deviceId, values:[boundingBox[0], boundingBox[1]],
                                description:'Visual grounding bounding-box min corner for device ' + deviceId + ', image ' + imageLabel,
                                vectorSpaceEnumId:imageVectorSpaceEnumId || 'EuclideanSpace2D', purposeEnumId:'VpPosition'}"/>
                    <service-call name="moqui.device.TrajectoryPlannerServices.create#PoseVector" out-map="maxVector"
                            in-map="{name:'bbox_max_' + deviceId, values:[boundingBox[2], boundingBox[3]],
                                description:'Visual grounding bounding-box max corner for device ' + deviceId + ', image ' + imageLabel,
                                vectorSpaceEnumId:imageVectorSpaceEnumId || 'EuclideanSpace2D', purposeEnumId:'VpPosition'}"/>
                    <set field="boundingBoxMinVectorId" from="minVector.vectorId"/>
                    <set field="boundingBoxMaxVectorId" from="maxVector.vectorId"/>
                </if>
                <if condition="saveCenter &amp;&amp; center">
                    <service-call name="moqui.device.TrajectoryPlannerServices.create#PoseVector" out-map="centerVector"
                            in-map="{name:'bbox_center_' + deviceId, values:center,
                                description:'Visual grounding center point for device ' + deviceId + ', image ' + imageLabel,
                                vectorSpaceEnumId:imageVectorSpaceEnumId || 'EuclideanSpace2D', purposeEnumId:'VpPosition'}"/>
                    <set field="centerVectorId" from="centerVector.vectorId"/>
                </if>
                <if condition="saveTargetPose &amp;&amp; targetPose">
                    <service-call name="moqui.device.TrajectoryPlannerServices.create#PoseVector" out-map="targetVector"
                            in-map="{name:'target_pose_' + deviceId, values:targetPose,
                                description:'Target TCP pose inferred from visual grounding for device ' + deviceId + ', image ' + imageLabel,
                                vectorSpaceEnumId:targetPoseVectorSpaceEnumId || 'EngTcpPose6Dof', purposeEnumId:'VpPosition'}"/>
                    <set field="targetPoseVectorId" from="targetVector.vectorId"/>
                </if>
            </if>
        </actions>
    </service>

    <!-- ========== Trajectory Planner ========== -->

    <service verb="run" noun="RobotArmTrajectoryPlanner">
        <description>
            Run a 6-DOF TCP waypoint planner with native ONNX Runtime, or an explicitly configured remote provider.
            MR-Moqui does not load DJL/JNI. The explicit linear-demo mode only interpolates endpoints.

            The model accepts [tcp_start(6) || tcp_goal(6)] (12 inputs) and produces
            N_WAYPOINTS x 6 TCP poses (flat output), aligned with the PLC waypoint
            space used by PLCopen Part 4 coordinated-motion FBs such as
            MC_MoveLinearAbsolute and MC_MoveCircularAbsolute.

            Persists results to:
                Vector / VectorComponent        — per-waypoint TCP poses + tcp_start/tcp_goal
                ApproximatedFunction            — parent function container
                ParametricPath                  — path-level metadata
                Trajectory                      — time-tagged motion
                ApproximatedFunctionSample      — one sample per waypoint
                ParametricPathPoint             — path point per sample
                TrajectoryPoint                 — time offset per sample
                MathModelRun                    — execution record
                MathModelPerf                   — latency / throughput counters
                MathModelData                   — links model to trajectory + input vectors

            Native mode loads MathModelDefContent.contentLocation through the Moqui
            resource facade as a local/component file. Remote mode delegates model
            loading to an explicitly configured provider. Optional obstacle data is provider-specific
            and must use calibrated world coordinates, not image pixels.
        </description>
        <in-parameters>
            <parameter name="mathModelId" required="true">
                <description>ID of the MathModel instance to use for inference.</description>
            </parameter>
            <parameter name="startPose" type="List" required="true">
                <description>6 TCP pose values [X,Y,Z,A,B,C] — start pose in the same space used by the PLC.</description>
            </parameter>
            <parameter name="goalPose" type="List" required="true">
                <description>6 TCP pose values [X,Y,Z,A,B,C] — goal pose in the same space used by the PLC.</description>
            </parameter>
            <parameter name="plannerMode" default-value="native">
                <description>native loads the registered ONNX artifact in-process; remote requires inferenceUrl; linear-demo is explicit interpolation only.</description>
            </parameter>
            <parameter name="onnxProfile" default-value="tcp12"/>
            <parameter name="inferenceUrl"/>
            <parameter name="apiKey"/>
            <parameter name="obstacle" type="Map">
                <description>Optional calibrated obstacle observation passed to the remote inference provider.</description>
            </parameter>
            <parameter name="trajectoryName" type="String" default-value=""/>
        </in-parameters>
        <out-parameters>
            <parameter name="mathModelRunId"/>
            <parameter name="approximatedFunctionId"/>
            <parameter name="mathModelPerfId"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="moqui.math.MathModel" value-field="mathModel">
                <field-map field-name="mathModelId"/>
            </entity-find-one>
            <if condition="!mathModel">
                <return error="true" message="MathModel ${mathModelId} not found"/>
            </if>
            <entity-find-one entity-name="moqui.math.MathModelDefContent" value-field="onnxContent">
                <field-map field-name="mathModelDefId" from="mathModel.mathModelDefId"/>
                <field-map field-name="contentTypeEnumId" value="MmCntOnnx"/>
            </entity-find-one>
            <if condition="!onnxContent">
                <return error="true" message="No ONNX content for MathModelDef ${mathModel.mathModelDefId}"/>
            </if>

            <if condition="!startPose?.length"><return error="true" message="Missing startPose."/></if>
            <if condition="!goalPose?.length"><return error="true" message="Missing goalPose."/></if>
            <service-call name="moqui.device.TrajectoryPlannerServices.check#Pose" out-map="startCheck"
                    in-map="{pose:startPose, fieldName:'startPose'}"/>
            <service-call name="moqui.device.TrajectoryPlannerServices.check#Pose" out-map="goalCheck"
                    in-map="{pose:goalPose, fieldName:'goalPose'}"/>
            <set field="startPoseList" from="startCheck.poseList"/>
            <set field="goalPoseList" from="goalCheck.poseList"/>
            <if condition="!['linear-demo', 'remote', 'native'].includes(plannerMode)">
                <return error="true" message="plannerMode must be native, remote or linear-demo."/>
            </if>
            <if condition="plannerMode === 'remote' &amp;&amp; !inferenceUrl">
                <return error="true" message="MR-Moqui requires inferenceUrl for model inference. Use plannerMode=linear-demo only for explicit interpolation examples."/>
            </if>
            <if condition="plannerMode === 'linear-demo' &amp;&amp; obstacle">
                <return error="true" message="linear-demo cannot plan around obstacles; configure an inference provider."/>
            </if>

            <set field="t0" from="Date.now()"/>
            <entity-make-value entity-name="moqui.math.MathModelRun" value-field="runVal"
                    map="{mathModelId:mathModelId, startTime:ec.user.nowTimestamp, hasError:'N',
                        parameters:JSON.stringify({startPose:startPoseList, goalPose:goalPoseList, plannerMode:plannerMode,
                            onnxProfile:onnxProfile, obstacle:obstacle || null})}"/>
            <entity-sequenced-id-primary value-field="runVal"/>
            <entity-create value-field="runVal"/>
            <set field="runId" from="runVal.mathModelRunId"/>

            <!-- a failed inference is recorded on the run before the service fails -->
            <set field="tInferStart" from="Date.now()"/>
            <service-call name="moqui.device.TrajectoryPlannerServices.infer#PlannerWaypoints" out-map="inference" ignore-error="true"
                    in-map="{plannerMode:plannerMode, mathModelId:mathModelId, startPose:startPoseList, goalPose:goalPoseList,
                        onnxProfile:onnxProfile, obstacle:obstacle, inferenceUrl:inferenceUrl, apiKey:apiKey}"/>
            <if condition="!inference?.waypoints">
                <set field="inferenceError" from="inference?.errorMessage || 'Trajectory inference returned an error.'"/>
                <entity-find-one entity-name="moqui.math.MathModelRun" value-field="failedRun" for-update="true">
                    <field-map field-name="mathModelRunId" from="runId"/>
                </entity-find-one>
                <entity-set value-field="failedRun" map="{endDate:ec.user.nowTimestamp, runningTimeMillis:Date.now() - t0,
                    hasError:'Y', errors:inferenceError}"/>
                <entity-update value-field="failedRun"/>
                <return error="true" message="Trajectory inference failed: ${inferenceError}"/>
            </if>
            <set field="waypoints" from="inference.waypoints"/>
            <set field="waypointCount" from="waypoints.length"/>
            <set field="inferenceLatencyMs" from="Date.now() - tInferStart"/>

            <entity-make-value entity-name="moqui.math.ApproximatedFunction" value-field="approximatedFunctionValue"
                    map="{vectorSpaceEnumId:'EngTcpPose6Dof', codomainTypeEnumId:'AfctVector', dataStorageEnumId:'AfdsPointTable',
                        purposeEnumId:'AfpRobotMotion', interpolationEnumId:plannerMode === 'linear-demo' ? 'AfiLinearPath' : 'AfiAIPath',
                        name:trajectoryName || ('AI Trajectory ' + runId), description:'6-DOF TCP waypoint trajectory from AI planner'}"/>
            <entity-sequenced-id-primary value-field="approximatedFunctionValue"/>
            <entity-create value-field="approximatedFunctionValue"/>
            <set field="approximatedFunctionId" from="approximatedFunctionValue.approximatedFunctionId"/>
            <service-call name="create#moqui.math.ParametricPath"
                    in-map="{approximatedFunctionId:approximatedFunctionId, profileEnumId:'PppfTrajectoryProfile'}"/>
            <service-call name="create#moqui.math.Trajectory"
                    in-map="{approximatedFunctionId:approximatedFunctionId, actuationTypeEnumId:'PtaVirtual', controlMethodEnumId:'PtcmNNControl'}"/>

            <set field="stepMs" from="waypointCount > 1 ? 1000.0 / (waypointCount - 1) : 0.0"/>
            <set field="waypointIndex" from="0"/>
            <iterate list="waypoints" entry="waypoint">
                <service-call name="moqui.device.TrajectoryPlannerServices.create#PoseVector" out-map="waypointVector"
                        in-map="{values:waypoint, purposeEnumId:'VpPosition'}"/>
                <entity-make-value entity-name="moqui.math.ApproximatedFunctionSample" value-field="sampleValue"
                        map="{approximatedFunctionId:approximatedFunctionId, sampleCode:'WP' + String(waypointIndex).padStart(4, '0'),
                            sampleName:'Waypoint ' + waypointIndex, sequenceNum:waypointIndex, sampleVectorId:waypointVector.vectorId,
                            sampleTypeEnumId:waypointIndex === 0 ? 'AfstStartPoint' : (waypointIndex === waypointCount - 1 ? 'AfstEndPoint' : 'AfstWaypoint')}"/>
                <entity-sequenced-id-secondary value-field="sampleValue"/>
                <entity-create value-field="sampleValue"/>
                <service-call name="create#moqui.math.ParametricPathPoint"
                        in-map="{approximatedFunctionId:approximatedFunctionId, approximatedFunctionSampleId:sampleValue.approximatedFunctionSampleId}"/>
                <service-call name="create#moqui.math.TrajectoryPoint"
                        in-map="{approximatedFunctionId:approximatedFunctionId, approximatedFunctionSampleId:sampleValue.approximatedFunctionSampleId,
                            pointTimeOffsetMillis:waypointIndex * stepMs}"/>
                <set field="waypointIndex" from="waypointIndex + 1"/>
            </iterate>

            <service-call name="moqui.device.TrajectoryPlannerServices.create#PoseVector" out-map="startVector"
                    in-map="{name:'tcp_start', values:startPoseList, purposeEnumId:'VpPosition'}"/>
            <service-call name="moqui.device.TrajectoryPlannerServices.create#PoseVector" out-map="goalVector"
                    in-map="{name:'tcp_goal', values:goalPoseList, purposeEnumId:'VpPosition'}"/>
            <set field="modelDataList" from="[
                {dataTypeEnumId:'MmdtApproxFunc', purposeEnumId:'MmdpModelOutputs', approximatedFunctionId:approximatedFunctionId, sequenceNum:1},
                {dataTypeEnumId:'MmdtVector', purposeEnumId:'MmdpModelInputs', vectorId:startVector.vectorId, sequenceNum:2},
                {dataTypeEnumId:'MmdtVector', purposeEnumId:'MmdpModelInputs', vectorId:goalVector.vectorId, sequenceNum:3}]"/>
            <iterate list="modelDataList" entry="modelData">
                <entity-make-value entity-name="moqui.math.MathModelData" value-field="modelDataValue"
                        map="Object.assign({mathModelId:mathModelId, generatedByRunId:runId}, modelData)"/>
                <entity-sequenced-id-primary value-field="modelDataValue"/>
                <entity-create value-field="modelDataValue"/>
            </iterate>

            <set field="elapsed" from="Date.now() - t0"/>
            <set field="totalDurationSec" from="elapsed > 0 ? elapsed / 1000.0 : 0.001"/>
            <entity-find-one entity-name="moqui.math.MathModelRun" value-field="finishedRun" for-update="true">
                <field-map field-name="mathModelRunId" from="runId"/>
            </entity-find-one>
            <entity-set value-field="finishedRun" map="{endDate:ec.user.nowTimestamp, runningTimeMillis:elapsed,
                approximatedFunctionId:approximatedFunctionId,
                results:JSON.stringify({approximatedFunctionId:approximatedFunctionId, waypointCount:waypointCount})}"/>
            <entity-update value-field="finishedRun"/>
            <entity-make-value entity-name="moqui.math.MathModelPerf" value-field="perfValue"
                    map="{mathModelRunId:runId, totalDurationSec:totalDurationSec, inferenceLatencyMs:Number(inferenceLatencyMs || 0),
                        throughputSamplesSec:Number(waypointCount || 0) / totalDurationSec}"/>
            <entity-sequenced-id-primary value-field="perfValue"/>
            <entity-create value-field="perfValue"/>
            <set field="mathModelRunId" from="runId"/>
            <set field="mathModelPerfId" from="perfValue.mathModelPerfId"/>
        </actions>
    </service>

    <service verb="get" noun="DeviceImage">
        <description>The image of a device for an inference provider: the DeviceContent given, or the latest DCntImage
            content of the device, read and encoded as standard base64.</description>
        <in-parameters>
            <parameter name="deviceId" required="true"/>
            <parameter name="deviceContentId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="deviceContent" type="EntityValue"/>
            <parameter name="imageBase64"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="moqui.device.Device" value-field="device">
                <field-map field-name="deviceId"/>
            </entity-find-one>
            <if condition="!device"><return error="true" message="Device ${deviceId} not found"/></if>
            <if condition="deviceContentId"><then>
                <entity-find-one entity-name="moqui.device.DeviceContent" value-field="deviceContent">
                    <field-map field-name="deviceContentId"/>
                </entity-find-one>
                <if condition="!deviceContent || deviceContent.deviceId != deviceId">
                    <return error="true" message="DeviceContent ${deviceContentId} not found for device ${deviceId}"/>
                </if>
            </then><else>
                <service-call name="moqui.device.DeviceServices.get#DeviceContentLocation" out-map="latest"
                        in-map="{deviceId:deviceId, contentTypeEnumIdList:['DCntImage']}"/>
                <set field="deviceContent" from="latest.deviceContent"/>
                <if condition="!deviceContent"><return error="true" message="No image DeviceContent found for device ${deviceId}"/></if>
            </else></if>
            <if condition="!deviceContent.contentLocation">
                <return error="true" message="DeviceContent ${deviceContent.deviceContentId} has no contentLocation"/>
            </if>
            <set field="imageBytes" from="ec.resource.getLocationReference(deviceContent.contentLocation).openStream()?.readAllBytes()"/>
            <if condition="imageBytes == null"><return error="true" message="Image file does not exist."/></if>
            <set field="imageBase64" from="StringUtilities.base64Encode(imageBytes)"/>
        </actions>
    </service>

    <service verb="check" noun="NumberList">
        <description>A list of decimal numbers from a provider response: no value gives no list; an empty entry or fewer
            than minSize values is an error.</description>
        <in-parameters>
            <parameter name="values"/>
            <parameter name="fieldName" required="true"/>
            <parameter name="minSize" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="numbers" type="List"/>
        </out-parameters>
        <actions>
            <if condition="values == null"><return/></if>
            <set field="sourceList" from="Array.isArray(values) ? values : [values]"/>
            <set field="numbers" from="[]"/>
            <set field="index" from="0"/>
            <iterate list="sourceList" entry="entry">
                <if condition="entry == null || String(entry).trim() === ''">
                    <return error="true" message="${fieldName}[${index}] is empty."/>
                </if>
                <set field="numbers" from="numbers.concat([toDecimal(String(entry))])"/>
                <set field="index" from="index + 1"/>
            </iterate>
            <if condition="minSize != null &amp;&amp; numbers.length &lt; minSize">
                <return error="true" message="${fieldName} must contain at least ${minSize} values."/>
            </if>
        </actions>
    </service>

    <service verb="check" noun="Pose">
        <description>A 6-DOF TCP pose: exactly six finite numbers.</description>
        <in-parameters>
            <parameter name="pose"/>
            <parameter name="fieldName" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="poseList" type="List"/>
        </out-parameters>
        <actions>
            <if condition="!Array.isArray(pose)">
                <return error="true" message="${fieldName} must be an Array with exactly 6 numeric values."/>
            </if>
            <if condition="pose.length !== 6">
                <return error="true" message="${fieldName} must contain exactly 6 numeric values, found ${pose.length}."/>
            </if>
            <set field="poseList" from="pose.map(value => Number(value))"/>
            <set field="badIndex" from="poseList.findIndex(value => !Number.isFinite(value))"/>
            <if condition="badIndex >= 0">
                <return error="true" message="${fieldName}[${badIndex}] must be numeric, found '${pose[badIndex]}'."/>
            </if>
        </actions>
    </service>

    <service verb="create" noun="PoseVector">
        <description>A Vector with one canonical VectorComponent per value, in order.</description>
        <in-parameters>
            <parameter name="values" type="List" required="true"/>
            <parameter name="name"/>
            <parameter name="description"/>
            <parameter name="vectorSpaceEnumId"/>
            <parameter name="purposeEnumId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="vectorId"/>
        </out-parameters>
        <actions>
            <entity-make-value entity-name="moqui.math.Vector" value-field="vectorValue"
                    map="{vectorTypeEnumId:'VtOrdinary', purposeEnumId:purposeEnumId, vectorSpaceEnumId:vectorSpaceEnumId,
                        name:name, description:description, dimension:values.length}"/>
            <entity-sequenced-id-primary value-field="vectorValue"/>
            <entity-create value-field="vectorValue"/>
            <set field="vectorId" from="vectorValue.vectorId"/>
            <set field="dimensionIndex" from="0"/>
            <iterate list="values" entry="value">
                <entity-make-value entity-name="moqui.math.VectorComponent" value-field="componentValue"
                        map="{vectorId:vectorId, dimensionIndex:dimensionIndex, componentTypeEnumId:'VctCanonical', realValue:value}"/>
                <entity-sequenced-id-primary value-field="componentValue"/>
                <entity-create value-field="componentValue"/>
                <set field="dimensionIndex" from="dimensionIndex + 1"/>
            </iterate>
        </actions>
    </service>

    <service verb="infer" noun="PlannerWaypoints">
        <description>The waypoints of the planner mode: linear-demo interpolates ten poses, native runs the ONNX model in
            process (OnnxServices.infer#TrajectoryWaypoints), remote calls the inference provider. A failure is
            errorMessage with no waypoints.</description>
        <in-parameters>
            <parameter name="plannerMode" required="true"/>
            <parameter name="mathModelId"/>
            <parameter name="startPose" type="List" required="true"/>
            <parameter name="goalPose" type="List" required="true"/>
            <parameter name="onnxProfile"/>
            <parameter name="obstacle" type="Map"/>
            <parameter name="inferenceUrl"/>
            <parameter name="apiKey"/>
        </in-parameters>
        <out-parameters>
            <parameter name="waypoints" type="List"/>
            <parameter name="errorMessage"/>
        </out-parameters>
        <actions>
            <if condition="plannerMode === 'linear-demo'"><then>
                <set field="candidates" from="Array.from({length:10}, (_, i) => startPose.map((v, j) => v + (i / 9) * (goalPose[j] - v)))"/>
            </then><else-if condition="plannerMode === 'native'">
                <service-call name="moqui.device.OnnxServices.infer#TrajectoryWaypoints" out-map="nativeOut" ignore-error="true"
                        in-map="{mathModelId:mathModelId, startPose:startPose, goalPose:goalPose, onnxProfile:onnxProfile, obstacle:obstacle || null}"/>
                <set field="candidates" from="nativeOut?.waypoints"/>
                <if condition="!candidates"><set field="errorMessage" value="Native ONNX inference returned an error."/><return/></if>
            </else-if><else>
                <service-call name="moqui.device.TrajectoryPlannerServices.call#InferenceEndpoint" out-map="remoteOut" ignore-error="true"
                        in-map="{url:inferenceUrl, apiKey:apiKey, payload:Object.assign({mathModelId:mathModelId, startPose:startPose,
                            goalPose:goalPose}, obstacle ? {obstacle:obstacle} : {})}"/>
                <set field="candidates" from="remoteOut?.response?.waypoints"/>
                <if condition="!candidates"><set field="errorMessage" value="Inference provider returned an error."/><return/></if>
            </else></if>
            <if condition="!Array.isArray(candidates) || candidates.length &lt; 2 || candidates.some(point => !Array.isArray(point)
                    || point.length !== 6 || point.some(value => typeof value !== 'number' || !Number.isFinite(value)))">
                <set field="errorMessage" value="Planner must return at least two waypoints, each with six finite numeric coordinates."/>
                <return/>
            </if>
            <set field="waypoints" from="candidates"/>
        </actions>
    </service>

    <service verb="get" noun="TrajectoryAxes">
        <description>
            Reads the waypoints of a planned trajectory (ApproximatedFunctionSample in sequenceNum order, each with its
            VectorComponent values) and returns one value list per axis. Axis names follow the vector space of the
            ApproximatedFunction: X,Y,Z,A,B,C for EngTcpPose6Dof, J1..J6 otherwise; a dimension beyond the sixth is
            named D and its index. TrajectoryAxisBinding is not used: this is the planned waypoint stream as it is.
        </description>
        <in-parameters>
            <parameter name="approximatedFunctionId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="axes" type="Map"/>
            <parameter name="waypointCount" type="Integer"/>
            <parameter name="vectorSpaceEnumId"/>
        </out-parameters>
        <actions>
            <entity-find entity-name="moqui.math.ApproximatedFunctionSample" list="samples">
                <econdition field-name="approximatedFunctionId"/>
                <order-by field-name="sequenceNum"/>
            </entity-find>
            <if condition="!samples?.length">
                <return error="true" message="No ApproximatedFunctionSample found for approximatedFunctionId ${approximatedFunctionId}."/>
            </if>
            <entity-find-one entity-name="moqui.math.ApproximatedFunction" value-field="approxFunc">
                <field-map field-name="approximatedFunctionId"/>
            </entity-find-one>
            <set field="vectorSpaceEnumId" from="approxFunc?.vectorSpaceEnumId || null"/>
            <set field="axisNames" from="vectorSpaceEnumId === 'EngTcpPose6Dof' ? ['X', 'Y', 'Z', 'A', 'B', 'C'] : ['J1', 'J2', 'J3', 'J4', 'J5', 'J6']"/>
            <set field="axes" from="{}"/>
            <iterate list="samples" entry="sample">
                <entity-find entity-name="moqui.math.VectorComponent" list="components">
                    <econdition field-name="vectorId" from="sample.sampleVectorId"/>
                    <order-by field-name="dimensionIndex"/>
                </entity-find>
                <iterate list="components" entry="comp">
                    <set field="dim" from="parseInt(comp.dimensionIndex, 10)"/>
                    <set field="axisKey" from="dim &lt; axisNames.length ? axisNames[dim] : 'D' + dim"/>
                    <!-- a decimal field is a Decimal object in the script: toNumber() reads it -->
                    <set field="axes[axisKey]" from="(axes[axisKey] || []).concat([(comp.realValue != null &amp;&amp; typeof comp.realValue.toNumber === 'function' ? comp.realValue.toNumber() : Number(comp.realValue))])"/>
                </iterate>
            </iterate>
            <set field="waypointCount" from="samples.length"/>
        </actions>
    </service>

    <service verb="export" noun="Trajectory" authenticate="false" transaction="ignore">
        <description>
            Publishes a planned trajectory for immediate execution (the ephemeral path; a recipe export through
            moqui.device.DeviceConfigServices.export#DeviceConfig is the persistent one). The axis values come from
            get#TrajectoryAxes and go out as one JSON message through run#DeviceRequest: the DeviceRequest is an MQTT
            write without items (requestTypeEnumId DrtWrite, runServiceName
            moqui.device.gateway.MqttServices.run#DeviceRequest, brokerUri the broker, query the topic that
            MqttParameterSub on the PLC subscribes to).

            Message:
                {"requestName": "ROBOT_ARM_TRAJECTORY_EXPORT", "approximatedFunctionId": "100051",
                 "waypointCount": 10, "mqttTopic": "moqui/robot/arm1/trajectory",
                 "axes": {"X": [850.0, 860.0], "Y": [0.0, 20.0]}}
        </description>
        <in-parameters>
            <parameter name="approximatedFunctionId" required="true"/>
            <parameter name="requestName" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="status"/>
            <parameter name="errorMessage"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="moqui.device.DeviceRequest" value-field="request">
                <field-map field-name="requestName"/>
            </entity-find-one>
            <if condition="!request"><return error="true" message="DeviceRequest ${requestName} not found."/></if>
            <service-call name="moqui.device.TrajectoryPlannerServices.get#TrajectoryAxes" out-map="trajectory"
                    in-map="{approximatedFunctionId:approximatedFunctionId}"/>
            <log level="info" message="Exporting trajectory ${approximatedFunctionId} (${trajectory.waypointCount} waypoints) with request ${requestName}"/>
            <service-call name="moqui.device.DeviceServices.run#DeviceRequest" out-map="result"
                    in-map="{requestName:requestName, payload:{requestName:requestName, approximatedFunctionId:approximatedFunctionId,
                        waypointCount:trajectory.waypointCount, mqttTopic:request.query || '', axes:trajectory.axes}}"/>
            <set field="status" from="result.status"/>
            <set field="errorMessage" from="result.errorMessage"/>
        </actions>
    </service>
</services>

<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- Compatibility names only; implementations belong to DeviceServices. -->
    <service verb="get" noun="DeviceConfigExportFiles">
        <implements service="moqui.device.DeviceServices.get#DeviceConfigExportFiles"/>
        <actions><service-call name="moqui.device.DeviceServices.get#DeviceConfigExportFiles" in-map="context" out-map="context"/></actions>
    </service>
    <service verb="export" noun="DeviceConfig" authenticate="false" transaction="ignore">
        <implements service="moqui.device.DeviceServices.export#DeviceConfig"/>
        <actions><service-call name="moqui.device.DeviceServices.export#DeviceConfig" in-map="context" out-map="context"/></actions>
    </service>
</services>

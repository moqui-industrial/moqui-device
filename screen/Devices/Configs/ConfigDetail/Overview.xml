<!-- ConfigDetail › Overview (plan/design-devices.md §3.5): the configuration's fields (get#Config). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Overview" default-menu-index="1">
    <parameter name="deviceConfigId" required="true"/>
    <actions>
        <service-call name="moqui.device.DeviceAppServices.get#Config" out-map="overview" transaction="force-new"
                ignore-error="true" in-map="{deviceConfigId:deviceConfigId}"/>
        <script>ec.message.clearErrors()</script>
        <set field="config" from="overview?.config || {}"/>
    </actions>
    <widgets>
        <container-box>
            <box-header title="Configuration"/>
            <box-body>
                <form-single name="ConfigFields" map="config">
                        <field name="typeText"><default-field title="Type"><display/></default-field></field>
                        <field name="purposeText"><default-field title="Purpose"><display/></default-field></field>
                        <field name="deviceTypeText"><default-field title="Device type"><display/></default-field></field>
                        <field name="controlMethodText"><default-field title="Control method"><display/></default-field></field>
                        <field name="approximatedFunctionId"><default-field title="Trajectory"><display/></default-field></field>
                        <field name="parentName"><default-field title="Part of"><display/></default-field></field>
                        <field name="fromDateText"><default-field title="From"><display/></default-field></field>
                        <field name="thruDateText"><default-field title="Through"><display/></default-field></field>
                        <field name="description"><default-field title="Description"><display/></default-field></field>
                    <field-layout>
                        <field-row><field-ref name="typeText"/><field-ref name="purposeText"/></field-row>
                        <field-row><field-ref name="deviceTypeText"/><field-ref name="controlMethodText"/></field-row>
                        <field-row><field-ref name="approximatedFunctionId"/><field-ref name="parentName"/></field-row>
                        <field-row><field-ref name="fromDateText"/><field-ref name="thruDateText"/></field-row>
                        <field-ref name="description"/>
                    </field-layout>
                </form-single>
            </box-body>
        </container-box>
    </widgets>
</screen>

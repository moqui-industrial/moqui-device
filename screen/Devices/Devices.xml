<!-- Devices › Devices (plan/design-devices.md §3.2, §3.3): the physical devices' list and their detail (hidden from the menu).
    recordKind tells the shared Find and DeviceDetail which records they show; Groups sets it to group. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Devices" default-menu-index="2" menu-image="sym_o_memory" menu-image-type="icon">
    <always-actions>
        <set field="recordKind" value="device"/>
    </always-actions>
    <subscreens default-item="Find" always-use-full-path="true"/>
    <widgets>
        <subscreens-active/>
    </widgets>
</screen>

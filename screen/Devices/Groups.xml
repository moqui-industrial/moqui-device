<!-- Devices › Groups (plan/design-devices.md §3.4): the groups' list (the device list with recordKind group) and GroupDetail,
    which shares the device detail's header and tabs (DevicesParts.xml, one template for both kinds, Practices-App-Dev §5), adds
    the Members tab and runs its requests through the group's controller. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Groups" default-menu-index="3" menu-image="sym_o_hub" menu-image-type="icon">
    <always-actions>
        <set field="recordKind" value="group"/>
    </always-actions>
    <subscreens default-item="Find" always-use-full-path="true">
        <subscreens-item name="Find" location="component://moqui-device/screen/Devices/Devices/Find.xml" menu-title="Groups"/>
        <subscreens-item name="GroupDetail" location="component://moqui-device/screen/Devices/Groups/GroupDetail.xml"
                menu-title="Group" menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
